@model APCD.Web.Models.ContactUs
@{
    ViewData["Title"] = "Contact Us";
}

<section class="py-5 bg-light" style="min-height: 80vh;">
    <div class="container">
        <!-- Page Header -->
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8 text-center">
                <h1 class="display-5 fw-bold text-dark mb-3">Contact Us</h1>
                <p class="text-secondary fs-5 mx-auto" style="max-width: 600px;">
                    Have questions about the empanelment process or technical issues? Our team is here to help you.
                </p>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="card border-0 shadow-lg overflow-hidden" style="border-radius: 20px;">
                    <div class="bg-white p-5">
                        <div class="mb-4">
                            <h3 class="fw-bold text-dark mb-1">Contact Information</h3>
                            <p class="text-secondary">Fill up the form and our Team will get back to you within 24 hours.</p>
                        </div>

                        @if (ViewBag.SuccessMessage != null)
                        {
                            <div class="alert alert-success border-0 bg-success bg-opacity-10 text-success rounded-3 p-4 mb-4 d-flex align-items-center" role="alert">
                                <i class="bi bi-check-circle-fill me-3 fs-4"></i>
                                <div>
                                    <h6 class="alert-heading fw-bold mb-1">Success!</h6>
                                    <p class="mb-0 small">@ViewBag.SuccessMessage</p>
                                </div>
                            </div>
                        }

                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger rounded-3 p-4 mb-4 d-flex align-items-center" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
                                <div>
                                    <h6 class="alert-heading fw-bold mb-1">Error</h6>
                                    <p class="mb-0 small">@ViewBag.ErrorMessage</p>
                                </div>
                            </div>
                        }

                        <form asp-action="Index" method="post" id="contactForm">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label asp-for="FirstName" class="form-label fw-semibold text-dark">First Name *</label>
                                    <input asp-for="FirstName" class="form-control form-control-lg border-0 bg-light rounded-3" placeholder="John" style="font-size: 0.95rem;">
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="LastName" class="form-label fw-semibold text-dark">Last Name *</label>
                                    <input asp-for="LastName" class="form-control form-control-lg border-0 bg-light rounded-3" placeholder="Doe" style="font-size: 0.95rem;">
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fw-semibold text-dark">Email Address *</label>
                                    <input asp-for="Email" class="form-control form-control-lg border-0 bg-light rounded-3" placeholder="john@example.com" style="font-size: 0.95rem;">
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Phone" class="form-label fw-semibold text-dark">Phone Number *</label>
                                    <input asp-for="Phone" class="form-control form-control-lg border-0 bg-light rounded-3" placeholder="9876543210" maxlength="10" oninput="this.value=this.value.replace(/[^0-9]/g,'')" style="font-size: 0.95rem;">
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="City" class="form-label fw-semibold text-dark">City</label>
                                    <input asp-for="City" class="form-control form-control-lg border-0 bg-light rounded-3" placeholder="New Delhi" style="font-size: 0.95rem;">
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="State" class="form-label fw-semibold text-dark">State</label>
                                    <input asp-for="State" class="form-control form-control-lg border-0 bg-light rounded-3" placeholder="Delhi" style="font-size: 0.95rem;">
                                </div>
                                <div class="col-12">
                                    <label asp-for="Summary" class="form-label fw-semibold text-dark">Your Message *</label>
                                    <textarea asp-for="Summary" class="form-control border-0 bg-light rounded-3" rows="5" placeholder="How can we help you?" style="font-size: 0.95rem; resize: none;"></textarea>
                                    <div class="d-flex justify-content-between mt-1">
                                        <span asp-validation-for="Summary" class="text-danger small"></span>
                                        <span id="wordCount" class="text-muted small">0 / 500 words</span>
                                    </div>
                                </div>
                                <div class="col-12 mt-4">
                                    <button type="submit" id="submitBtn" class="btn btn-success btn-lg px-5 py-3 rounded-3 fw-bold w-100" style="background: #1f5e3b; border: none; transition: all 0.3s;">
                                        Send Message <i class="bi bi-send ms-2"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Word count logic
            $('#Summary').on('input', function() {
                var words = this.value.trim().split(/\s+/).filter(Boolean).length;
                $('#wordCount').text(words + ' / 500 words');
                
                if (words > 500) {
                    $('#wordCount').addClass('text-danger').removeClass('text-muted');
                } else {
                    $('#wordCount').addClass('text-muted').removeClass('text-danger');
                }
            });

            // Loading state on submit
            $('#contactForm').on('submit', function() {
                if ($(this).valid()) {
                    var btn = $('#submitBtn');
                    btn.prop('disabled', true);
                    btn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Sending...');
                }
            });
        });
    </script>
}

<style>
    .form-control:focus {
        background-color: #fff !important;
        box-shadow: 0 0 0 4px rgba(31, 94, 59, 0.1);
        border: 1px solid #1f5e3b !important;
    }
    .hover-opacity-100:hover {
        opacity: 1 !important;
    }
</style>
