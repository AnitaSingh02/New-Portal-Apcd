@model IEnumerable<APCD.Web.Models.EmpanelmentApplication>

@{
    int GetCount(APCD.Web.Models.EmpanelmentApplication app, string type) {
        if (app.Capabilities == null) return 0;
        
        return app.Capabilities.Count(c => {
            if (!c.IsAppliedForEmpanelment) return false;
            
            var main = c.MainType ?? "";
            var sub = c.SubTech ?? "";

            switch (type) {
                case "BagFilter":
                    return main.Contains("Bag Filter", StringComparison.OrdinalIgnoreCase) || main.Contains("Baghouse", StringComparison.OrdinalIgnoreCase);
                case "Cyclone":
                    return main.Contains("Cyclone", StringComparison.OrdinalIgnoreCase);
                case "Scrubber":
                    return main.Contains("Scrubber", StringComparison.OrdinalIgnoreCase);
                case "ESP":
                    return main.Equals("ESP", StringComparison.OrdinalIgnoreCase);
                case "FumeExtraction":
                    return main.Contains("fume", StringComparison.OrdinalIgnoreCase) || main.Contains("extraction", StringComparison.OrdinalIgnoreCase);
                case "EGB":
                    return sub.Contains("Gravel Bed", StringComparison.OrdinalIgnoreCase) || sub.Contains("EGB", StringComparison.OrdinalIgnoreCase);
                case "HybridOther":
                    return (main.Contains("Hybrid", StringComparison.OrdinalIgnoreCase) || main.Contains("Other", StringComparison.OrdinalIgnoreCase)) 
                           && !sub.Contains("Gravel Bed", StringComparison.OrdinalIgnoreCase) && !sub.Contains("EGB", StringComparison.OrdinalIgnoreCase);
                case "RECD":
                    return main.Contains("RECD", StringComparison.OrdinalIgnoreCase) || main.Contains("Not Applicable", StringComparison.OrdinalIgnoreCase);
                default:
                    return false;
            }
        });
    }

    string RenderCount(int count) {
        if (count == 0) return "<span class=\"text-muted\" style=\"color: #ced4da !important;\">0</span>";
        return $"<span class=\"badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 border border-success border-opacity-25\">{count}</span>";
    }
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold text-dark">Consolidated Summary Sheet</h6>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-success rounded-pill px-3">
                <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
            </button>
            <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                <i class="bi bi-file-earmark-pdf me-1"></i> Export PDF
            </button>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-4 border-start border-4 border-primary shadow-sm" style="transition: transform 0.2s ease;">
                    <div class="small text-muted fw-bold mb-1"><i class="bi bi-buildings me-1"></i> Total OEMs</div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.Count()</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-4 border-start border-4 border-success shadow-sm" style="transition: transform 0.2s ease;">
                    <div class="small text-muted fw-bold mb-1"><i class="bi bi-gear-wide-connected me-1"></i> Total Devices Applied</div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.Sum(a => a.Capabilities?.Count(c => c.IsAppliedForEmpanelment) ?? 0)</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-4 border-start border-4 border-info shadow-sm" style="transition: transform 0.2s ease;">
                    <div class="small text-muted fw-bold mb-1"><i class="bi bi-cash-stack me-1"></i> Total Fees Received</div>
                    <h3 class="fw-bold mb-0 text-dark">₹@((Model.SelectMany(a => a.Payments ?? new List<APCD.Web.Models.Payment>()).Sum(p => p.Amount ?? 0m) / 100000m).ToString("N2")) L</h3>
                </div>
            </div>
        </div>

        <div class="table-responsive mt-3">
            <table class="table table-hover table-bordered align-middle w-100" style="white-space: nowrap;">
                <thead class="bg-light fw-bold" style="font-size: 0.8rem; letter-spacing: 0.3px; color: #495057;">
                    <tr class="text-center">
                        <th class="text-start">OEM Name</th>
                        <th>Bag Filter</th>
                        <th>Cyclone</th>
                        <th>Scrubber</th>
                        <th>ESP</th>
                        <th>Hybrid/Other</th>
                        <th>Fume Extraction</th>
                        <th>EGB</th>
                        <th>RECD</th>
                        <th class="bg-primary text-white bg-opacity-75">Total APCD</th>
                    </tr>
                </thead>
                <tbody style="font-size: 0.85rem;">
                    @foreach (var app in Model)
                    {
                        var bf = GetCount(app, "BagFilter");
                        var cy = GetCount(app, "Cyclone");
                        var sc = GetCount(app, "Scrubber");
                        var esp = GetCount(app, "ESP");
                        var ho = GetCount(app, "HybridOther");
                        var fe = GetCount(app, "FumeExtraction");
                        var egb = GetCount(app, "EGB");
                        var recd = GetCount(app, "RECD");
                        var total = app.Capabilities?.Count(c => c.IsAppliedForEmpanelment) ?? 0;

                        <tr class="text-center" style="cursor: pointer;" onclick="window.location.href='@Url.Action("Details", "Admin", new { id = app.Id })'">
                            <td class="text-start fw-bold text-dark">
                                <div class="text-truncate" style="max-width: 200px;" title="@app.User.CompanyName">@app.User.CompanyName</div>
                                <div class="small text-muted fw-normal mt-1">@app.Status</div>
                            </td>
                            <td>@Html.Raw(RenderCount(bf))</td>
                            <td>@Html.Raw(RenderCount(cy))</td>
                            <td>@Html.Raw(RenderCount(sc))</td>
                            <td>@Html.Raw(RenderCount(esp))</td>
                            <td>@Html.Raw(RenderCount(ho))</td>
                            <td>@Html.Raw(RenderCount(fe))</td>
                            <td>@Html.Raw(RenderCount(egb))</td>
                            <td>@Html.Raw(RenderCount(recd))</td>
                            <td class="fw-bolder" style="background-color: #f8f9fa;">@Html.Raw(RenderCount(total))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
