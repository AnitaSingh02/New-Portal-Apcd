@model IEnumerable<APCD.Web.Models.InstallationRecord>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold text-dark">Field Verification Details</h6>
        <div class="d-flex gap-2">
            <select id="state-filter" class="form-select form-select-sm rounded-pill" style="width: 150px;">
                <option value="">All States</option>
                <option value="Delhi">Delhi</option>
                <option value="Haryana">Haryana</option>
                <option value="Uttar Pradesh">Uttar Pradesh</option>
            </select>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light extra-small fw-bold text-muted text-uppercase">
                    <tr>
                        <th class="ps-4">App ID</th>
                        <th>Device Location</th>
                        <th>Status</th>
                        <th>Verified By</th>
                        <th>Date</th>
                        <th>Cert Issued</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inst in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted small">@(inst.Application.ApplicationId ?? "#" + inst.ApplicationId.ToString("0000"))</td>
                            <td class="fw-bold">
                                <div>@inst.Location</div>
                                <small class="text-muted fw-normal">@inst.ClientName</small>
                            </td>
                            <td>
                                <span class="badge @(inst.VerificationStatus == "Completed" ? "bg-success" : "bg-warning text-dark") rounded-pill px-2">
                                    @inst.VerificationStatus
                                </span>
                            </td>
                            <td class="small">@(inst.VerifiedBy ?? "N/A")</td>
                            <td class="small">@(inst.VerificationDate?.ToString("dd MMM yyyy") ?? "Pending")</td>
                            <td class="text-center">
                                <i class="bi @(inst.IsCertificateIssued ? "bi-check-circle-fill text-success" : "bi-dash-circle text-muted") fs-5"></i>
                            </td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-dark rounded-pill">Update</button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">No installation records found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
