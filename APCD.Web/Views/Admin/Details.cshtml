@model APCD.Web.Models.EmpanelmentApplication
@using System.Security.Claims
@{
    ViewData["Title"] = "Review Application";
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value;

    // Define Role-Specific Next Steps
    var nextStatus = Model.Status switch {
        "Submitted" when (userRole == "DEALING_HAND" || userRole == "ADMIN" || userRole == "SUPER_ADMIN") => "DocumentApproved",
        "DocumentApproved" when (userRole == "OFFICER" || userRole == "ADMIN" || userRole == "SUPER_ADMIN") => "ProvisionalGranted",
        "ProvisionalGranted" when (userRole == "FIELD_VERIFIER" || userRole == "ADMIN" || userRole == "SUPER_ADMIN") => "FieldVerified",
        "FieldVerified" when (userRole == "OFFICER" || userRole == "ADMIN" || userRole == "SUPER_ADMIN") => "CommitteeReviewPending",
        "CommitteeReviewPending" when (userRole == "COMMITTEE" || userRole == "ADMIN" || userRole == "SUPER_ADMIN") => "Empaneled",
        _ => (userRole == "ADMIN" || userRole == "SUPER_ADMIN") ? "Manual-Review-Required" : null
    };

    var actionLabel = nextStatus switch {
        "DocumentApproved" => "Verify Documents",
        "ProvisionalGranted" => "Grant Provisional Status",
        "FieldVerified" => "Submit Field Report",
        "CommitteeReviewPending" => "Schedule Final Committee Review",
        "Empaneled" => "Issue Final Empanelment",
        _ => "Administrative Feedback Only"
    };
}

<div class="container py-5 mt-4">
    <div class="row g-4 animate-fade-in">
        <!-- Main Application Content -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-4 px-4 border-bottom d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="fw-bold text-gov-blue mb-1">Empanelment Application @(Model.ApplicationId ?? "#" + Model.Id.ToString("0000"))</h4>
                        <p class="text-muted small mb-0">Submitted by <strong>@Model.User.CompanyName</strong> on @Model.SubmittedAt?.ToLongDateString()</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Application" asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-sm btn-outline-gov-blue rounded-pill px-3 fw-bold">
                            <i class="bi bi-printer me-1"></i> Print Full App
                        </a>
                        <span class="badge bg-gov-blue text-white rounded-pill px-4 py-2">@Model.Status</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <!-- OEM Profile Section -->
                    <div class="row mb-5">
                        <div class="col-12 mb-3">
                            <h6 class="fw-bold text-muted text-uppercase extra-small letter-spacing">OEM Profile</h6>
                            <hr class="mt-2 mb-4" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <small class="text-muted d-block">Company Name</small>
                            <span class="fw-bold text-gov-blue fs-5">@(Model.User.CompanyProfile?.CompanyName ?? "No Profile Found")</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <small class="text-muted d-block">GST / PAN</small>
                            <span class="fw-bold text-gov-blue">@(Model.User.CompanyProfile?.GSTNumber ?? "-") / @(Model.User.CompanyProfile?.PANNumber ?? "-")</span>
                        </div>
                        <div class="col-md-12 mb-3">
                            <small class="text-muted d-block">Factory Address</small>
                            <span class="text-secondary small">@(Model.User.CompanyProfile?.FactoryAddress ?? "-")</span>
                        </div>
                    </div>

                    <!-- Payment Section -->
                    @if (Model.Payments != null && Model.Payments.Any())
                    {
                        <div class="row mb-5">
                            <div class="col-12 mb-3">
                                <h6 class="fw-bold text-muted text-uppercase extra-small letter-spacing">Payment Details</h6>
                                <hr class="mt-2 mb-4" />
                            </div>
                            @foreach (var payment in Model.Payments)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="p-3 @(payment.Type == APCD.Web.Models.PaymentType.Supplemental ? "bg-white border-gov-gold border border-start border-4" : "bg-light border-success border-start border-4") rounded-4 h-100 shadow-sm">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <small class="text-muted fw-bold">@payment.Type Fee</small>
                                            <span class="badge bg-secondary extra-small">@payment.Status</span>
                                        </div>
                                        <h4 class="fw-bold text-success fs-5">₹@((payment.Amount ?? 0).ToString("N0"))</h4>
                                        <div class="extra-small text-muted"><span class="fw-bold">UTR:</span> @payment.UTRNumber</div>
                                        <div class="extra-small text-muted"><span class="fw-bold">Bank:</span> @payment.RemitterBank</div>
                                        <div class="extra-small text-muted"><span class="fw-bold">Date:</span> @(payment.PaymentDate?.ToShortDateString() ?? "N/A")</div>
                                        @if (payment.APCDTypesCount.HasValue && payment.APCDTypesCount > 0)
                                        {
                                            <div class="extra-small text-muted mt-1"><i class="bi bi-info-circle"></i> Covers @payment.APCDTypesCount APCD Unit(s)</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Supplemental Requests Tracking (Batches) -->
                    @if (Model.SupplementalRequests != null && Model.SupplementalRequests.Any())
                    {
                        <div class="row mb-5">
                            <div class="col-12 mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="fw-bold text-muted text-uppercase extra-small letter-spacing mb-0">Supplemental APCD Tracking (Batches)</h6>
                                    <span class="badge bg-gov-gold bg-opacity-10 text-gov-gold border border-gov-gold border-opacity-25 rounded-pill px-3 py-1 extra-small fw-bold">
                                        Batch-wise History
                                    </span>
                                </div>
                                <hr class="mt-2 mb-4" />
                            </div>
                            <div class="col-12">
                                @foreach (var request in Model.SupplementalRequests.OrderByDescending(r => r.CreatedAt))
                                {
                                    <div class="card border-gov-gold border-opacity-25 rounded-4 overflow-hidden mb-4 shadow-sm">
                                        <div class="card-header bg-gov-gold bg-opacity-10 border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-layers-half text-gov-gold"></i>
                                                <span class="fw-bold text-gov-blue">Batch #SUP-@request.Id.ToString("000")</span>
                                                @{
                                                    var reqBadge = request.Status == "Submitted" ? "bg-primary" : (request.Status == "Approved" ? "bg-success" : (request.Status == "Rejected" ? "bg-danger" : "bg-warning"));
                                                }
                                                <span class="badge @reqBadge extra-small rounded-pill">@request.Status</span>
                                            </div>
                                            <span class="text-muted extra-small">Final Submit: <strong>@(request.FinalSubmittedAt?.ToString("MMM dd, yyyy HH:mm") ?? "In Draft")</strong></span>
                                        </div>
                                        <div class="p-4">
                                            <div class="row g-4">
                                                <!-- Devices List -->
                                                <div class="col-md-6">
                                                    <small class="text-muted fw-bold d-block mb-2 text-uppercase">Newly Added Devices</small>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        @foreach(var dev in request.Devices)
                                                        {
                                                            <div class="p-2 border rounded-3 bg-light small w-100">
                                                                <div class="fw-bold text-dark">@dev.SubTech</div>
                                                                <div class="extra-small text-muted">@dev.Category | Range: @dev.DesignedCapacity</div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- Payment Details -->
                                                <div class="col-md-6">
                                                    <small class="text-muted fw-bold d-block mb-2 text-uppercase">Supplemental Payment Details</small>
                                                    @{ var supPay = request.Payments.OrderByDescending(p => p.Id).FirstOrDefault(); }
                                                    @if (supPay != null)
                                                    {
                                                        <div class="p-3 bg-white border border-dashed rounded-3">
                                                            <div class="d-flex justify-content-between mb-1">
                                                                <span class="small text-muted">Base Amount:</span>
                                                                <span class="small fw-bold">₹@supPay.Amount.ToString("N0")</span>
                                                            </div>
                                                            <div class="d-flex justify-content-between mb-1">
                                                                <span class="small text-muted">GST (18%):</span>
                                                                <span class="small fw-bold">₹@supPay.GST.ToString("N0")</span>
                                                            </div>
                                                            <div class="d-flex justify-content-between border-top pt-2 mt-1">
                                                                <span class="small fw-bold text-dark">Total Deposited:</span>
                                                                <span class="small fw-bold text-success">₹@supPay.TotalAmount.ToString("N0")</span>
                                                            </div>
                                                            <div class="mt-3 pt-2 border-top">
                                                                <div class="extra-small text-muted"><span class="fw-bold text-uppercase">UTR Number:</span> <span class="text-dark">@supPay.UTRNumber</span></div>
                                                                <div class="extra-small text-muted"><span class="fw-bold">Payment Date:</span> <span class="text-dark">@supPay.PaymentDate.ToString("MMM dd, yyyy")</span></div>
                                                                @if (!string.IsNullOrEmpty(supPay.ReceiptPath))
                                                                {
                                                                    <a href="@supPay.ReceiptPath" target="_blank" class="btn btn-sm btn-outline-gov-blue mt-3 w-100 py-1 fw-bold">
                                                                        <i class="bi bi-file-earmark-pdf me-1"></i> View Supplemental Proof
                                                                    </a>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="alert alert-secondary py-2 small mb-0"><i class="bi bi-info-circle me-1"></i> No payment record linked to this batch.</div>
                                                    }
                                                </div>

                                                <!-- New Documents -->
                                                <div class="col-12 mt-4">
                                                    <small class="text-muted fw-bold d-block mb-2 text-uppercase">Supplemental Documents (Batch-Specific)</small>
                                                    <div class="table-responsive rounded-3 border">
                                                        <table class="table table-sm mb-0 extra-small table-hover align-middle">
                                                            <thead class="bg-light">
                                                                <tr>
                                                                    <th class="ps-3 py-2">APCD Type</th>
                                                                    <th>Document Type</th>
                                                                    <th>File Name</th>
                                                                    <th class="text-end pe-3">Action</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach(var doc in request.Documents)
                                                                {
                                                                    <tr>
                                                                        <td class="ps-3 py-2 fw-bold text-dark">@doc.APCDType</td>
                                                                        <td class="text-muted">@doc.DocumentType</td>
                                                                        <td class="text-truncate text-muted" style="max-width: 250px;">@doc.FileName</td>
                                                                        <td class="text-end pe-3">
                                                                            <a href="@doc.FilePath" target="_blank" class="btn btn-sm btn-link py-0 text-decoration-none fw-bold">View Document</a>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                                @if(!request.Documents.Any()) {
                                                                    <tr><td colspan="4" class="text-center py-3 text-muted">No documents uploaded for this batch.</td></tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Documents Section -->
                    <div class="row mb-5">
                        <div class="col-12 mb-3">
                            <h6 class="fw-bold text-muted text-uppercase extra-small letter-spacing">Uploaded Documents</h6>
                            <hr class="mt-2 mb-4" />
                        </div>
                        <div class="col-12">
                            @{ 
                                var activeDocs = Model.Documents.Where(d => d.IsActive).ToList();
                                var commonGroups = activeDocs
                                    .Where(d => d.DocumentCategory == "Common")
                                    .GroupBy(d => d.StepNumber)
                                    .OrderBy(g => g.Key);
                                
                                var apcdGroups = activeDocs
                                    .Where(d => d.DocumentCategory == "APCD")
                                    .GroupBy(d => d.AssociatedTech)
                                    .OrderBy(g => g.Key);

                                string GetStepName(int step) => step switch {
                                    2 => "Step 2: Classifications",
                                    3 => "Step 3: Key Personnel",
                                    4 => "Step 4: Technical Scope (Common)",
                                    5 => "Step 5: Financials & Documents",
                                    _ => $"Step {step}"
                                };
                            }

                            @if (commonGroups.Any())
                            {
                                <h6 class="text-gov-blue fw-bold mb-3 d-flex align-items-center">
                                    <i class="bi bi-files me-2"></i>Common Documents (Step-wise)
                                </h6>
                                
                                @foreach (var group in commonGroups)
                                {
                                    <div class="mb-4">
                                        <div class="bg-light border-start border-4 border-gov-blue px-3 py-2 small fw-bold text-gov-blue mb-0 rounded-end">
                                            @GetStepName(group.Key)
                                        </div>
                                        <div class="table-responsive rounded-bottom-4 border-start border-end border-bottom">
                                            <table class="table table-hover mb-0 align-middle">
                                                <tbody>
                                                    @foreach (var doc in group)
                                                    {
                                                        <tr>
                                                            <td class="ps-4 small text-gov-blue fw-semibold" style="width: 40%">@doc.DocumentType</td>
                                                            <td class="text-muted small text-truncate" style="max-width: 200px;">@doc.FileName</td>
                                                            <td class="text-end pe-4">
                                                                <div id="doc-actions-@doc.Id" class="d-flex justify-content-end align-items-center gap-2" data-doc-type="@Html.Raw(doc.DocumentType.Replace("\"", "&quot;"))" data-file-path="@doc.FilePath">
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 extra-small fw-bold" onclick="viewHistory(@doc.Id)" title="View History">
                                                                        <i class="bi bi-clock-history"></i>
                                                                    </button>
                                                                    <a href="@doc.FilePath" target="_blank" class="btn btn-sm btn-outline-gov-blue py-1 shadow-sm"><i class="bi bi-eye"></i></a>
                                                                    
                                                                    @if (doc.DocumentStatus == "Rejected")
                                                                    {
                                                                        <span class="badge bg-danger rounded-pill px-3 py-2 extra-small fw-bold" title="@doc.RejectionReason"><i class="bi bi-x-circle-fill me-1"></i> Rejected</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 extra-small fw-bold" onclick="openRejectModal(@doc.Id, '@Html.Raw(doc.DocumentType.Replace("'", "\\'"))')">
                                                                            <i class="bi bi-x-circle me-1"></i>Reject
                                                                        </button>
                                                                        <button type="button" onclick="toggleVerify(@doc.Id, @Model.Id)" class="btn btn-sm @(doc.DocumentStatus == "Verified" ? "btn-success" : "btn-outline-success") rounded-pill px-3 py-1 extra-small fw-bold verify-btn">
                                                                            <i class="bi @(doc.DocumentStatus == "Verified" ? "bi-check-circle-fill" : "bi-check-circle") me-1"></i>@(doc.DocumentStatus == "Verified" ? "Verified" : "Verify")
                                                                        </button>
                                                                    }
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                }
                            }

                            @if (apcdGroups.Any())
                            {
                                <h6 class="text-gov-blue fw-bold mb-3 mt-5 d-flex align-items-center">
                                    <i class="bi bi-cpu me-2"></i>APCD Specific Documents
                                </h6>
                                
                                @foreach (var group in apcdGroups)
                                {
                                    <div class="mb-4">
                                        <div class="bg-gov-blue text-white px-3 py-2 rounded-top-4 small fw-bold">
                                            <i class="bi bi-gear-fill me-2"></i> Documents for: @group.Key
                                        </div>
                                        <div class="table-responsive rounded-bottom-4 border-start border-end border-bottom">
                                            <table class="table table-hover mb-0 align-middle">
                                                <tbody>
                                                    @foreach (var doc in group)
                                                    {
                                                        <tr>
                                                            <td class="ps-4 small text-gov-blue fw-semibold" style="width: 40%">@doc.DocumentType</td>
                                                            <td class="text-muted small text-truncate" style="max-width: 200px;">@doc.FileName</td>
                                                            <td class="text-end pe-4">
                                                                <div id="doc-actions-@doc.Id" class="d-flex justify-content-end align-items-center gap-2" data-doc-type="@Html.Raw(doc.DocumentType.Replace("\"", "&quot;"))" data-file-path="@doc.FilePath">
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 extra-small fw-bold" onclick="viewHistory(@doc.Id)" title="View History">
                                                                        <i class="bi bi-clock-history"></i>
                                                                    </button>
                                                                    <a href="@doc.FilePath" target="_blank" class="btn btn-sm btn-outline-gov-blue py-1 shadow-sm"><i class="bi bi-eye"></i></a>
                                                                    
                                                                    @if (doc.DocumentStatus == "Rejected")
                                                                    {
                                                                        <span class="badge bg-danger rounded-pill px-3 py-2 extra-small fw-bold" title="@doc.RejectionReason"><i class="bi bi-x-circle-fill me-1"></i> Rejected</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 extra-small fw-bold" onclick="openRejectModal(@doc.Id, '@Html.Raw(doc.DocumentType.Replace("'", "\\'"))')">
                                                                            <i class="bi bi-x-circle me-1"></i>Reject
                                                                        </button>
                                                                        <button type="button" onclick="toggleVerify(@doc.Id, @Model.Id)" class="btn btn-sm @(doc.DocumentStatus == "Verified" ? "btn-success" : "btn-outline-success") rounded-pill px-3 py-1 extra-small fw-bold verify-btn">
                                                                            <i class="bi @(doc.DocumentStatus == "Verified" ? "bi-check-circle-fill" : "bi-check-circle") me-1"></i>@(doc.DocumentStatus == "Verified" ? "Verified" : "Verify")
                                                                        </button>
                                                                    }
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>


                    <!-- Installatons Section -->
                    <div class="row">
                        <div class="col-12 mb-3">
                            <h6 class="fw-bold text-muted text-uppercase extra-small letter-spacing">Installation Experience</h6>
                            <hr class="mt-2 mb-4" />
                        </div>
                        <div class="col-12">
                            <div class="row g-3">
                                @foreach (var inst in Model.Installations)
                                {
                                    <div class="col-md-6">
                                        <div class="p-3 bg-light rounded-4 border-0">
                                            <div class="fw-bold text-gov-blue">@inst.ClientName</div>
                                            <div class="small text-muted mb-2"><i class="bi bi-geo-alt me-1"></i>@inst.Location</div>
                                            <div class="extra-small text-muted fw-bold text-uppercase">Completed @@ @(inst.Year?.ToString() ?? inst.InstallationDate?.ToShortDateString() ?? "N/A")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Actions & Timeline -->
        <div class="col-lg-4">
            <!-- Workflow Action Center -->
            @if (nextStatus != null)
            {
                <div class="card shadow-sm border-0 border-top border-4 border-gov-gold rounded-4 overflow-hidden mb-4 animate-slide-up">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-gov-blue mb-4">Workflow Action Center</h5>
                        
                        <form asp-action="ProcessAction" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            
                            <div class="mb-4">
                                <label class="form-label small fw-bold text-muted text-uppercase">Internal Remark / Decision Note</label>
                                <textarea name="comment" class="form-control bg-light" rows="4" placeholder="Mention document validity, missing info, or verification notes..." required></textarea>
                            </div>

                            <div class="d-grid gap-2">
                                @if (nextStatus != "Manual-Review-Required")
                                {
                                    bool allDocsVerified = Model.Documents.Any() && Model.Documents.All(d => d.IsVerified);
                                    bool isVerifyAction = actionLabel == "Verify Documents";
                                    <input type="hidden" name="nextStatus" value="@nextStatus" />
                                    <button type="submit" class="btn btn-gov-primary btn-lg py-3 rounded-pill fw-bold shadow-sm" @Html.Raw(isVerifyAction && !allDocsVerified ? "disabled title=\"Please verify all documents first\"" : "")>
                                        @actionLabel <i class="bi bi-shield-check ms-1"></i>
                                    </button>
                                }
                                else
                                {
                                    <input type="hidden" name="nextStatus" value="@Model.Status" />
                                    <button type="submit" class="btn btn-outline-gov-blue btn-lg py-3 rounded-pill fw-bold">
                                        Add Internal Remark <i class="bi bi-chat-left-text ms-1"></i>
                                    </button>
                                }
                                
                                <div class="d-flex gap-2 mt-2">
                                    <button type="submit" name="nextStatus" value="Rejected" class="btn btn-outline-danger btn-sm rounded-pill flex-grow-1">Reject Application</button>
                                    <button type="submit" name="nextStatus" value="Request-Info" class="btn btn-outline-warning btn-sm rounded-pill flex-grow-1">Request Info</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }

            <!-- Status Tracking Timeline -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="mb-0 fw-bold text-gov-blue">Internal History & Remarks</h6>
                </div>
                <div class="card-body p-4">
                    <div class="timeline">
                        <!-- Initial Submission -->
                        <div class="timeline-item pb-4">
                            <div class="timeline-marker bg-success"></div>
                            <div class="timeline-content ps-3">
                                <h6 class="mb-0 fw-bold small text-gov-blue">Application Submitted</h6>
                                <p class="extra-small text-muted mb-0">@Model.SubmittedAt?.ToLongDateString()</p>
                            </div>
                        </div>

                        <!-- Current Remarks Log -->
                        @foreach (var remark in Model.Remarks.OrderByDescending(r => r.CreatedAt))
                        {
                            <div class="timeline-item pb-4">
                                <div class="timeline-marker bg-gov-blue"></div>
                                <div class="timeline-content ps-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="mb-0 fw-bold small text-gov-blue">@remark.UserName</h6>
                                        <span class="badge bg-light text-muted extra-small p-1 border rounded-pill px-2">@remark.Role</span>
                                    </div>
                                    <p class="small text-secondary mt-1 mb-1 italic">"@remark.Comment"</p>
                                    <p class="extra-small text-muted mb-0">@remark.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <a asp-action="Index" class="btn btn-link text-muted extra-small d-block text-center text-decoration-none">← Back to Dashboard Queue</a>
        </div>
    </div>
</div>

<!-- Document History Modal -->
<div class="modal fade" id="historyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-gov-blue">Document Review History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="table-responsive">
                    <table class="table table-sm align-middle small">
                        <thead class="bg-light">
                            <tr>
                                <th>Version</th>
                                <th>Status</th>
                                <th>Reason / Comments</th>
                                <th>Date</th>
                                <th>Action By</th>
                            </tr>
                        </thead>
                        <tbody id="historyBody">
                            <!-- History items will be loaded here -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Reject Document Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header bg-danger text-white rounded-top-4 border-0">
                <h5 class="modal-title fw-bold" id="rejectModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Reject Document</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-3">Please select a reason for rejecting the document <strong id="rejectDocName" class="text-dark"></strong>:</p>
                <form id="rejectForm">
                    <input type="hidden" id="rejectDocId" name="documentId" />
                    
                    <div class="mb-3">
                        <div class="form-check mb-2">
                            <input class="form-check-input rejection-radio" type="radio" name="rejectionType" id="reason1" value="Incomplete Document" required>
                            <label class="form-check-label text-dark" for="reason1">Incomplete Document</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input rejection-radio" type="radio" name="rejectionType" id="reason2" value="Invalid Format">
                            <label class="form-check-label text-dark" for="reason2">Invalid Format</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input rejection-radio" type="radio" name="rejectionType" id="reason3" value="Incorrect Information">
                            <label class="form-check-label text-dark" for="reason3">Incorrect Information</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input rejection-radio" type="radio" name="rejectionType" id="reason4" value="Not Relevant Document">
                            <label class="form-check-label text-dark" for="reason4">Not Relevant Document</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input rejection-radio" type="radio" name="rejectionType" id="reason5" value="Other">
                            <label class="form-check-label text-dark" for="reason5">Other</label>
                        </div>
                    </div>
                    
                    <div class="mb-3 d-none" id="otherReasonContainer">
                        <label for="otherReasonText" class="form-label small fw-bold text-muted">Please specify reason <span class="text-danger">*</span></label>
                        <textarea class="form-control bg-light" id="otherReasonText" name="rejectionReason" rows="3" placeholder="Enter custom reason here..."></textarea>
                        <div class="invalid-feedback">Please provide a reason.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger rounded-pill px-4" id="saveRejectBtn">Save Rejection <i class="bi bi-check2 ms-1"></i></button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Notification -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="liveToast" class="toast border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-success text-white border-0">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong class="me-auto">Success</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body bg-white text-dark" id="toastMessage">
            Document rejected successfully.
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateDocUI(docId, isVerified, isRejected, rejectionReason) {
            const container = document.getElementById(`doc-actions-${docId}`);
            if (!container) return;

            const filePath = container.getAttribute('data-file-path');
            const docType = container.getAttribute('data-doc-type');
            const safeDocType = docType.replace(/'/g, "\\'");

            let html = `
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 extra-small fw-bold" onclick="viewHistory(${docId})" title="View History">
                    <i class="bi bi-clock-history"></i>
                </button>
                <a href="${filePath}" target="_blank" class="btn btn-sm btn-outline-gov-blue py-1 shadow-sm"><i class="bi bi-eye"></i></a>`;

            if (isRejected) {
                html += `<span class="badge bg-danger rounded-pill px-3 py-2 extra-small fw-bold" title="${rejectionReason}"><i class="bi bi-x-circle-fill me-1"></i> Rejected</span>`;
            } else {
                html += `
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 extra-small fw-bold" onclick="openRejectModal(${docId}, '${safeDocType}')">
                        <i class="bi bi-x-circle me-1"></i>Reject
                    </button>
                    <button type="button" onclick="toggleVerify(${docId}, @Model.Id)" class="btn btn-sm ${isVerified ? 'btn-success' : 'btn-outline-success'} rounded-pill px-3 py-1 extra-small fw-bold verify-btn">
                        <i class="bi ${isVerified ? 'bi-check-circle-fill' : 'bi-check-circle'} me-1"></i>${isVerified ? 'Verified' : 'Verify'}
                    </button>`;
            }
            container.innerHTML = html;
        }

        function viewHistory(docId) {
            const tbody = document.getElementById('historyBody');
            tbody.innerHTML = '<tr><td colspan="5" class="text-center py-3"><div class="spinner-border spinner-border-sm text-gov-blue" role="status"></div></td></tr>';
            
            var modal = new bootstrap.Modal(document.getElementById('historyModal'));
            modal.show();

            // Using the same endpoint as OEM dashboard
            fetch(`/OEM/GetDocumentHistory?documentId=${docId}`)
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        if (result.history.length === 0) {
                            tbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">No history found.</td></tr>';
                            return;
                        }

                        let html = '';
                        result.history.forEach(h => {
                            let badgeClass = h.status === 'Verified' ? 'bg-success' : (h.status === 'Rejected' ? 'bg-danger' : (h.status === 'Re-uploaded' ? 'bg-primary' : 'bg-warning'));
                            html += `
                                <tr>
                                    <td><span class="badge bg-light text-dark">v${h.version}</span></td>
                                    <td><span class="badge ${badgeClass}">${h.status}</span></td>
                                    <td style="max-width: 200px;" class="text-wrap">${h.reason || (h.type || '-')}</td>
                                    <td>${h.date}</td>
                                    <td>${h.by}</td>
                                </tr>
                            `;
                        });
                        tbody.innerHTML = html;
                    } else {
                        tbody.innerHTML = `<tr><td colspan="5" class="text-center py-3 text-danger">${result.message}</td></tr>`;
                    }
                })
                .catch(err => {
                    console.error('Error fetching history:', err);
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-danger">Failed to load history.</td></tr>';
                });
        }

        function toggleVerify(docId, appId) {
            const btn = event.currentTarget;
            const originalContent = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
            btn.disabled = true;

            const formData = new FormData();
            formData.append('docId', docId);
            formData.append('appId', appId);

            fetch('/Admin/VerifyDocument', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    updateDocUI(docId, result.isVerified, false, '');
                    
                    document.getElementById('toastMessage').innerText = result.isVerified ? 'Document verified successfully.' : 'Verification removed.';
                    var toastEl = document.getElementById('liveToast');
                    var toast = new bootstrap.Toast(toastEl);
                    toast.show();
                } else {
                    btn.innerHTML = originalContent;
                    btn.disabled = false;
                    alert(result.message || 'Error updating verification status.');
                }
            })
            .catch(error => {
                btn.innerHTML = originalContent;
                btn.disabled = false;
                console.error('Error:', error);
                alert('A network error occurred.');
            });
        }

        function openRejectModal(docId, docType) {
            document.getElementById('rejectDocId').value = docId;
            document.getElementById('rejectDocName').innerText = docType;
            
            // Reset form
            document.getElementById('rejectForm').reset();
            document.getElementById('otherReasonContainer').classList.add('d-none');
            document.getElementById('otherReasonText').removeAttribute('required');
            document.getElementById('otherReasonText').classList.remove('is-invalid');
            
            var modal = new bootstrap.Modal(document.getElementById('rejectModal'));
            modal.show();
        }

        document.querySelectorAll('.rejection-radio').forEach(radio => {
            radio.addEventListener('change', function() {
                const otherContainer = document.getElementById('otherReasonContainer');
                const otherTextarea = document.getElementById('otherReasonText');
                
                if (this.value === 'Other') {
                    otherContainer.classList.remove('d-none');
                    otherTextarea.setAttribute('required', 'required');
                } else {
                    otherContainer.classList.add('d-none');
                    otherTextarea.removeAttribute('required');
                    otherTextarea.classList.remove('is-invalid');
                    otherTextarea.value = '';
                }
            });
        });

        document.getElementById('saveRejectBtn').addEventListener('click', function() {
            const form = document.getElementById('rejectForm');
            const otherTextarea = document.getElementById('otherReasonText');
            
            if (!form.checkValidity()) {
                form.reportValidity();
                if (document.getElementById('reason5').checked && !otherTextarea.value.trim()) {
                    otherTextarea.classList.add('is-invalid');
                }
                return;
            }

            const formData = new FormData(form);
            const data = {
                documentId: parseInt(formData.get('documentId')),
                rejectionType: formData.get('rejectionType'),
                rejectionReason: formData.get('rejectionType') === 'Other' ? formData.get('rejectionReason') : formData.get('rejectionType')
            };

            const btn = this;
            const originalText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Saving...';
            btn.disabled = true;

            fetch('/Admin/RejectDocument', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                btn.innerHTML = originalText;
                btn.disabled = false;
                
                if (result.success) {
                    var modalEl = document.getElementById('rejectModal');
                    var modal = bootstrap.Modal.getInstance(modalEl);
                    modal.hide();
                    
                    updateDocUI(data.documentId, false, true, data.rejectionReason);

                    document.getElementById('toastMessage').innerText = result.message || 'Document rejected successfully.';
                    var toastEl = document.getElementById('liveToast');
                    var toast = new bootstrap.Toast(toastEl);
                    toast.show();
                } else {
                    alert(result.message || 'An error occurred.');
                }
            })
            .catch(error => {
                btn.innerHTML = originalText;
                btn.disabled = false;
                console.error('Error:', error);
                alert('A network error occurred. Please try again.');
            });
        });
    </script>
}

<style>
    body { background-color: #f8f9fa; }
    .extra-small { font-size: 0.7rem; }
    .letter-spacing { letter-spacing: 0.5px; }
    .fw-600 { font-weight: 600; }
    .italic { font-style: italic; }

    /* Timeline Styles */
    .timeline { border-left: 2px solid #e9ecef; position: relative; }
    .timeline-item { position: relative; }
    .timeline-marker {
        position: absolute;
        left: -8px; top: 0;
        width: 14px; height: 14px;
        border-radius: 50%;
        border: 2px solid white;
    }
</style>
