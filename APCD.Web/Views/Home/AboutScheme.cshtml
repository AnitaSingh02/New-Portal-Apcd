@{
    ViewData["Title"] = "About the Scheme";
}

<style>
    .scheme-section {
        background-color: #fafafa;
        padding-bottom: 60px;
        min-height: 100vh;
    }
    .scheme-heading-container {
        background-color: #f0f0f0;
        padding: 20px 0;
        margin-bottom: 40px;
    }
    .scheme-heading {
        font-size: 2.5rem;
        font-weight: 300;
        margin: 0;
        letter-spacing: 0.5px;
    }
    .text-black-accent {
        color: #222;
        border-bottom: 2px solid #222;
        padding-bottom: 4px;
    }
    .text-blue-accent {
        color: #007bff; 
    }
    .scheme-text {
        color: #444;
        font-size: 1.05rem;
        line-height: 1.8;
        margin-bottom: 1.5rem;
    }
    .scheme-subheading {
        font-size: 2.2rem;
        font-weight: 300;
        margin-top: 45px;
        margin-bottom: 25px;
        letter-spacing: 0.5px;
    }
    .scheme-list {
        color: #444;
        font-size: 1.05rem;
        line-height: 1.8;
        padding-left: 20px;
        margin-bottom: 1.5rem;
    }
    .scheme-list li {
        margin-bottom: 8px;
    }
</style>

<div class="scheme-section">
    <!-- Main Heading -->
    <div class="scheme-heading-container">
        <div class="container">
            <h1 class="scheme-heading">
                About theScheme
            </h1>
        </div>
    </div>

    <div class="container mt-5">
        <p class="scheme-text">
            The <b>Empanelment of Original Equipment Manufacturers (OEMs) of Air Pollution Control Devices (APCDs)</b> is a structured initiative implemented by the <b>National Productivity Council (NPC)</b> to ensure deployment of <b>technically sound, efficient, and compliant pollution control technologies </b>across industrial units in Delhi–NCR.
        </p>
        
        <p class="scheme-text">
            The scheme has been developed in alignment with to create a <b>transparent, credible, and performance-based empanelment system</b> for APCD manufacturers. It aims to facilitate industries in selecting <b>verified and technically competent OEMs,</b> thereby strengthening air pollution control mechanisms.
        </p>

        <p class="scheme-text">
            The empanelment process includes <b>document verification, technical evaluation, field performance assessment, and committee review,</b> ensuring that only capable OEMs are empanelled.
        </p>

        <!-- Applicability -->
        <h3 class="scheme-subheading">
            <span>Applicability</span>
        </h3>
        <p class="scheme-text">
            The scheme covers OEMs involved in the design, manufacturing, and supply of:
        </p>
        <ul class="scheme-list">
            <li>Electrostatic Precipitators (ESP)</li>
            <li>Bag Filters / Baghouse Systems</li>
            <li>Cyclone Separators</li>
            <li>Wet &amp; Dry Scrubbers</li>
            <li>Fume Extraction Systems (FES)</li>
            <li>Advanced / Hybrid APCDs</li>
        </ul>
        <p class="scheme-text">
            It applies to APCDs installed in industrial boilers, furnaces, thermic fluid heaters.
        </p>

        <!-- Disclaimer -->
        <h4 class="scheme-subheading mt-5">
           Disclaimer
        </h4>
        <div class="alert alert-secondary border-0 border-start border-4 border-secondary rounded-0 shadow-sm mt-3 mb-5" role="alert">
            <p class="mb-0" style="color: #555; line-height: 1.6;">
                <strong>Empanelment by NPC is a recommendatory process and does not constitute statutory approval or guarantee of performance.</strong> Responsibility for performance, compliance, and operation of APCDs rests solely with the OEM and user industry.
            </p>
        </div>
    </div>
</div>
