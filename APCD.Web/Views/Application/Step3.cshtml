@model List<APCD.Web.Models.StaffDetail>
@{
    ViewData["Title"] = "Key Personnel";
    int currentStep = 3;
    var appId = ViewBag.AppId ?? ViewContext.RouteData.Values["id"];
    var commercial = Model.FirstOrDefault(s => s.StaffType == "Commercial");
    var technical = Model.FirstOrDefault(s => s.StaffType == "Technical");
}

@section Styles {
    <link rel="stylesheet" href="~/css/application-form.css" asp-append-version="true" />
}

<div class="container py-5">
    <div class="card wizard-container border-0 shadow-lg">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-lg-3">
                <partial name="_WizardSidebar" model="currentStep" />
            </div>

            <!-- Main Content -->
            <div class="col-lg-9 bg-white">
                <div class="wizard-main">
                    @if (ViewBag.IsSubmitted == true)
                    {
                        <div class="alert alert-info d-flex align-items-center border-0 shadow-sm mb-4 py-3" style="background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%); border-left: 5px solid #0ea5e9 !important;">
                            <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">View Mode – Submission Completed</h6>
                                <p class="small mb-0 text-muted">This application has been submitted and is currently in read-only mode. No further edits are allowed.</p>
                            </div>
                            <i class="bi bi-lock-fill ms-auto fs-3 text-info opacity-25"></i>
                        </div>
                    }

                    <fieldset @(ViewBag.IsSubmitted == true ? "disabled" : "")>
                        <div class="form-section-title">Step 3: Details of Key Personnel</div>
                        <p class="text-muted small mb-5">Please provide contact details of the authorized persons for Commercial and Technical matters.</p>

                        <div class="row g-5">
                            <!-- Commercial In-charge -->
                            <div class="col-md-6">
                                <div class="p-4 rounded-4 border h-100" style="background-color: #f8fbff;">
                                    <h5 class="fw-bold mb-4 text-primary"><i class="bi bi-briefcase me-2"></i> 21. Commercial In-charge</h5>
                                    <form asp-action="AddStaff" asp-route-id="@appId" method="post">
                                        <input type="hidden" name="StaffType" value="Commercial" />
                                        <div class="mb-3">
                                            <label class="form-group-label small">Full Name</label>
                                            <input name="Name" class="form-control custom-input" placeholder="e.g. John Doe" value="@commercial?.Name" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-group-label small">Designation</label>
                                            <input name="Designation" class="form-control custom-input" placeholder="e.g. Manager (Sales)" value="@commercial?.Designation" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-group-label small">Mobile No.</label>
                                            <input name="MobileNo" class="form-control custom-input" placeholder="10-digit number" value="@commercial?.MobileNo" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-group-label small">E-mail ID</label>
                                            <input name="Email" type="email" class="form-control custom-input" placeholder="official@email.com" value="@commercial?.Email" required />
                                        </div>
                                        @if (commercial == null) {
                                            <button type="submit" class="btn btn-primary btn-sm px-4">Save Commercial Details</button>
                                        } else if (ViewBag.IsSubmitted != true) {
                                            <div class="text-success small fw-bold"><i class="bi bi-check-circle-fill"></i> Details Saved</div>
                                        }
                                    </form>
                                </div>
                            </div>

                            <!-- Technical In-charge -->
                            <div class="col-md-6">
                                <div class="p-4 rounded-4 border h-100" style="background-color: #fdfdfd;">
                                    <h5 class="fw-bold mb-4 text-primary"><i class="bi bi-tools me-2"></i> 22. Technical In-charge</h5>
                                    <form asp-action="AddStaff" asp-route-id="@appId" method="post">
                                        <input type="hidden" name="StaffType" value="Technical" />
                                        <div class="mb-3">
                                            <label class="form-group-label small">Full Name</label>
                                            <input name="Name" class="form-control custom-input" placeholder="e.g. Robert Smith" value="@technical?.Name" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-group-label small">Designation</label>
                                            <input name="Designation" class="form-control custom-input" placeholder="e.g. Chief Engineer" value="@technical?.Designation" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-group-label small">Mobile No.</label>
                                            <input name="MobileNo" class="form-control custom-input" placeholder="10-digit number" value="@technical?.MobileNo" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-group-label small">E-mail ID</label>
                                            <input name="Email" type="email" class="form-control custom-input" placeholder="tech@email.com" value="@technical?.Email" required />
                                        </div>
                                        @if (technical == null) {
                                            <button type="submit" class="btn btn-primary btn-sm px-4">Save Technical Details</button>
                                        } else if (ViewBag.IsSubmitted != true) {
                                            <div class="text-success small fw-bold"><i class="bi bi-check-circle-fill"></i> Details Saved</div>
                                        }
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Organization Documents -->
                        <form asp-action="SaveStep3Docs" asp-route-id="@appId" method="post" enctype="multipart/form-data">
                            <div class="row g-4 mt-4">
                                <div class="col-md-12">
                                    <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-diagram-3 me-2"></i> Section G: Organization Documents</h5>
                                </div>
                                <div class="col-md-6">
                                    <div id="card_orgChartFile" class="p-3 border rounded-3 bg-light h-100 shadow-sm transition-all hover-elevate">
                                        <label class="form-group-label fw-bold small mb-2">23. Organizational Chart</label>
                                        @{ var docs = ViewBag.Documents as List<APCD.Web.Models.ApplicationDocument>; }
                                        @{ var orgDoc = docs?.FirstOrDefault(d => d.DocumentType == "OrganizationalChart"); }
                                        
                                        <div class="upload-zone @(orgDoc != null ? "d-none" : "")">
                                            <input type="file" name="orgChartFile" class="form-control form-control-sm mt-2" accept=".pdf" 
                                                   onchange="uploadFileAjax(this, '@appId', '', 'OrganizationalChart', 'orgChartFile', 3)" />
                                        </div>

                                        <div class="status-zone @(orgDoc != null ? "" : "d-none")">
                                            <div class="d-flex flex-column gap-2 mt-2">
                                                <div class="d-flex align-items-center gap-2 text-success small fw-bold">
                                                    <i class="bi bi-file-earmark-check-fill fs-5"></i>
                                                    <span class="text-truncate status-filename" style="max-width: 180px;">Uploaded: @(orgDoc?.FileName)</span>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <a href="@(orgDoc?.FilePath ?? "#")" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                    @if (ViewBag.IsSubmitted != true) {
                                                        <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('@appId', '', 'OrganizationalChart', 'orgChartFile')">Remove</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="loading-zone d-none text-center py-2">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div id="card_staffQualFile" class="p-3 border rounded-3 bg-light h-100 shadow-sm transition-all hover-elevate">
                                        <label class="form-group-label fw-bold small mb-2">24. Staff Qualification Details (Annexure-7)</label>
                                        @{ var qualDoc = docs?.FirstOrDefault(d => d.DocumentType == "StaffQualification"); }
                                        
                                        <div class="upload-zone @(qualDoc != null ? "d-none" : "")">
                                            <input type="file" name="staffQualFile" class="form-control form-control-sm mt-2" accept=".pdf" 
                                                   onchange="uploadFileAjax(this, '@appId', '', 'StaffQualification', 'staffQualFile', 3)" />
                                        </div>

                                        <div class="status-zone @(qualDoc != null ? "" : "d-none")">
                                            <div class="d-flex flex-column gap-2 mt-2">
                                                <div class="d-flex align-items-center gap-2 text-success small fw-bold">
                                                    <i class="bi bi-file-earmark-check-fill fs-5"></i>
                                                    <span class="text-truncate status-filename" style="max-width: 180px;">Uploaded: @(qualDoc?.FileName)</span>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <a href="@(qualDoc?.FilePath ?? "#")" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                    @if (ViewBag.IsSubmitted != true) {
                                                        <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('@appId', '', 'StaffQualification', 'staffQualFile')">Remove</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="loading-zone d-none text-center py-2">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </form>
                    </fieldset>

                    <!-- Navigation -->
                    <div class="mt-5 pt-4 border-top d-flex justify-content-between" style="position: relative; z-index: 1000;">
                        <a href="@Url.Action("Step2", new { id = appId })" class="btn btn-wizard-prev shadow-sm">
                            <i class="bi bi-arrow-left me-2"></i> Previous
                        </a>
                        <a href="@Url.Action("Step4", new { id = appId })" class="btn btn-wizard-next shadow-sm">
                            Next Step: Technical Scope <i class="bi bi-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_DocumentUploadScripts" />
    <script>
        const existingDocs = @Html.Raw(Json.Serialize(ViewBag.JsonDocuments));
        
        function onUploadSuccess(docType, tech, fileName, filePath) {
            const existingIdx = existingDocs.findIndex(d => d.documentType === docType && d.associatedTech === tech);
            if (existingIdx > -1) {
                existingDocs[existingIdx] = { documentType: docType, associatedTech: tech, fileName: fileName, filePath: filePath };
            } else {
                existingDocs.push({ documentType: docType, associatedTech: tech, fileName: fileName, filePath: filePath });
            }
        }

        function onDeleteSuccess(docType, tech) {
            const existingIdx = existingDocs.findIndex(d => d.documentType === docType && d.associatedTech === tech);
            if (existingIdx > -1) existingDocs.splice(existingIdx, 1);
        }
    </script>
}
