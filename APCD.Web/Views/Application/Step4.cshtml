@model List<APCD.Web.Models.APCDCapability>
@{
    ViewData["Title"] = "Technical Scope";
    int currentStep = 4;
    var appId = ViewBag.AppId;

    var technologies = new[] {
        new { Main = "ESP", Subs = new[] { "Dry ESP (Plate/Tube Type)", "Wet ESP" } },
        new { Main = "Bag Filter/ Baghouse Systems", Subs = new[] { "Pulse Jet Baghouse", "Reverse Air Baghouse", "Mechanical Shaker Baghouse" } },
        new { Main = "Cyclones", Subs = new[] { "Single Cyclone", "Twin Cyclone", "Multi Cyclone / Multi-Clone", "High-Efficiency Cyclone" } },
        new { Main = "Wet Scrubber", Subs = new[] { "Venturi Scrubber", "Spray Tower / Spray Scrubber", "Packed Bed Scrubber", "Submerged Scrubber", "Multi-Stage Wet Scrubber" } },
        new { Main = "Dry Scrubber", Subs = new[] { "Dry Sorbent Injection", "Semi-Dry Scrubber" } },
        new { Main = "Hybrid/ other", Subs = new[] { "Hybrid ESP–Baghouse", "Hybrid Wet–Dry Scrubbers", "Electrostatic Gravel Bed", "New advance/ patented /Hybrid technologies /Others" } },
        new { Main = "Industrial fume/dust extraction system (except APCD)", Subs = new[] { "Standard System" } }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/application-form.css" asp-append-version="true" />
}

<div class="container py-4">
    <div class="card wizard-container border-0 shadow-lg">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-lg-3">
                <partial name="_WizardSidebar" model="currentStep" />
            </div>

            <!-- Main Content -->
            <div class="col-lg-9 bg-white">
                <div class="wizard-main">
                    @if (ViewBag.IsSubmitted == true)
                    {
                        <div class="alert alert-info d-flex align-items-center border-0 shadow-sm mb-4 py-3" style="background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%); border-left: 5px solid #0ea5e9 !important;">
                            <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">View Mode – Submission Completed</h6>
                                <p class="small mb-0 text-muted">This application has been submitted and is currently in read-only mode. No further edits are allowed.</p>
                            </div>
                            <i class="bi bi-lock-fill ms-auto fs-3 text-info opacity-25"></i>
                        </div>
                    }

                    <form asp-action="SaveCapabilities" asp-route-id="@appId" asp-route-supplementalId="@ViewBag.SupplementalId" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="supplementalId" value="@ViewBag.SupplementalId" />
                        <fieldset @(ViewBag.IsSubmitted == true && ViewBag.IsAddMoreMode != true ? "disabled" : "")>
                            @if (ViewBag.IsSupplementalMode == true)
                            {
                                <div class="alert alert-warning border-0 shadow-sm mb-4 d-flex align-items-center">
                                    <i class="bi bi-pencil-square fs-4 me-3"></i>
                                    <div>
                                        <h6 class="fw-bold mb-0">Supplemental Mode – Add More APCD</h6>
                                        <p class="small mb-0">You are adding new devices to your existing empanelment. Previously submitted devices are locked.</p>
                                    </div>
                                </div>
                            }
                            <div class="form-section-title">Step 4: Installation Experience (APCD Technologies)</div>
                            <p class="text-muted small mb-4"><strong>Point 25: Specify the APCDs currently manufactured and those for which empanelment is sought.</strong></p>
                            <div class="alert alert-info py-3 small mb-5">
                                <h6 class="fw-bold mb-2"><i class="bi bi-info-circle-fill me-2"></i>Note on Empanelment Categories:</h6>
                                <b class="text-dark">Category 1:</b> APCDs installed on Boilers / Furnaces / Thermic Fluid Heaters (TFH) flue-gas emission control.<br />
                                <b class="text-dark">Category 2:</b> APCDs installed on Non-Boiler / Non-Furnace / Non-TFH/ Non-heat dust/gas emission control.<br />
                                <span class="d-inline-block mt-2">If you have past experience in installing the relevant APCD under both Category 1 and Category 2, please select '<strong>Both</strong>' in the drop-down above. If not, please indicate category '1' or '2', as applicable.</span>
                            </div>
                            <div class="table-responsive border rounded-4 overflow-hidden mb-4">
                                <table class="table tech-matrix-table mb-0 align-middle">
                                    <thead style="background-color: #c9daf8;">
                                        <tr>
                                            <th style="width: 18%;">Type of APCD</th>
                                            <th style="width: 25%;">Technology Type</th>
                                            <th class="text-center bg-light text-dark" style="width: 12%;">Manufactured by OEMs.<br/><small class="fw-normal">Yes/No</small></th>
                                            <th class="text-center bg-light text-dark" style="width: 12%;">Applied for Empanelment<br/><small class="fw-normal">Yes/No</small></th>
                                            <th class="text-center" style="width: 15%;">Category<br/><small class="fw-normal">(1/2/Both)</small></th>
                                            <th style="width: 18%;">Designed Capacity<br/><small class="fw-normal">(give range)</small></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ 
                                            int i = 0; 
                                            int mainTechCounter = 1;
                                        }
                                        @foreach (var tech in technologies)
                                        {
                                            bool isFirst = true;
                                            @foreach (var sub in tech.Subs)
                                            {
                                                var existing = Model.FirstOrDefault(c => c.MainType == tech.Main && c.SubTech == sub);
                                                bool isLocked = (ViewBag.IsSubmitted == true && (ViewBag.IsAddMoreMode != true || (existing != null && existing.IsAppliedForEmpanelment)));
                                                
                                                <tr class="data-grid-row @(isLocked ? "bg-light opacity-75" : "")">
                                                    @if (isFirst)
                                                    {
                                                        <td rowspan="@tech.Subs.Length" class="fw-bold bg-light">
                                                            @mainTechCounter. @tech.Main
                                                        </td>
                                                        isFirst = false;
                                                    }
                                                    <td class="small pt-3 pb-3">
                                                        @sub
                                                        @if (sub.Contains("patented") || sub.Contains("Others"))
                                                        {
                                                            <div class="mt-2 pt-2 border-top border-light">
                                                                <strong class="text-dark small mb-1 d-block">If yes, specify the type:</strong>
                                                                @if (isLocked)
                                                                {
                                                                    <input type="text" class="form-control form-control-sm" value="@existing?.TypeDetails" disabled />
                                                                    <input type="hidden" name="capabilities[@i].TypeDetails" value="@existing?.TypeDetails" />
                                                                }
                                                                else
                                                                {
                                                                    <input type="text" name="capabilities[@i].TypeDetails" class="form-control form-control-sm tech-type-input" placeholder="__________________" value="@existing?.TypeDetails" />
                                                                }
                                                            </div>
                                                        }
                                                    </td>
                                                    <td class="text-center bg-light">
                                                        <input type="hidden" name="capabilities[@i].MainType" value="@tech.Main" />
                                                        <input type="hidden" name="capabilities[@i].SubTech" value="@sub" />
                                                        <div class="form-check d-flex justify-content-center mb-0">
                                                            @if (isLocked)
                                                            {
                                                                <input type="checkbox" class="form-check-input mt-0" style="width: 1.25em; height: 1.25em;" @(existing?.IsManufactured == true ? "checked" : "") disabled />
                                                                <input type="hidden" name="capabilities[@i].IsManufactured" value="@(existing?.IsManufactured == true ? "true" : "false")" />
                                                            }
                                                            else
                                                            {
                                                                <input type="checkbox" name="capabilities[@i].IsManufactured" value="true" class="form-check-input mt-0 tech-mfg-checkbox" style="width: 1.25em; height: 1.25em;" @(existing?.IsManufactured == true ? "checked" : "") />
                                                                <input type="hidden" name="capabilities[@i].IsManufactured" value="false" />
                                                            }
                                                        </div>
                                                    </td>
                                                    <td class="text-center bg-light">
                                                        <div class="form-check d-flex justify-content-center mb-0">
                                                            @if (isLocked)
                                                            {
                                                                <input type="checkbox" class="form-check-input mt-0" style="width: 1.25em; height: 1.25em;" @(existing?.IsAppliedForEmpanelment == true ? "checked" : "") disabled />
                                                                <input type="hidden" name="capabilities[@i].IsAppliedForEmpanelment" value="@(existing?.IsAppliedForEmpanelment == true ? "true" : "false")" data-tech-name="@sub" />
                                                            }
                                                            else
                                                            {
                                                                <input type="checkbox" name="capabilities[@i].IsAppliedForEmpanelment" value="true" class="form-check-input mt-0 tech-apply-checkbox" data-tech-name="@sub" style="width: 1.25em; height: 1.25em;" @(existing?.IsAppliedForEmpanelment == true ? "checked" : "") />
                                                                <input type="hidden" name="capabilities[@i].IsAppliedForEmpanelment" value="false" />
                                                            }
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @if (isLocked)
                                                        {
                                                            <select class="form-select form-select-sm" disabled>
                                                                <option value="@existing?.Category" selected>@(string.IsNullOrEmpty(existing?.Category) ? "NA" : existing.Category)</option>
                                                            </select>
                                                            <input type="hidden" name="capabilities[@i].Category" value="@existing?.Category" />
                                                        }
                                                        else
                                                        {
                                                            <select name="capabilities[@i].Category" class="form-select form-select-sm tech-category-select">
                                                                <option value="">NA</option>
                                                                <option value="1" selected="@(existing?.Category == "1")">1</option>
                                                                <option value="2" selected="@(existing?.Category == "2")">2</option>
                                                                <option value="both" selected="@(existing?.Category == "both")">Both</option>
                                                            </select>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (isLocked)
                                                        {
                                                            <input class="form-control form-control-sm" value="@existing?.DesignedCapacity" disabled />
                                                            <input type="hidden" name="capabilities[@i].DesignedCapacity" value="@existing?.DesignedCapacity" />
                                                        }
                                                        else
                                                        {
                                                            <input name="capabilities[@i].DesignedCapacity" class="form-control form-control-sm tech-capacity-input" placeholder="e.g. 500-2000 CFM" value="@existing?.DesignedCapacity" />
                                                        }
                                                    </td>
                                                </tr>
                                                i++;
                                            }
                                            mainTechCounter++;
                                        }
                                    </tbody>
                                </table>
                            </div>

                           

                            <!-- Point 22: Installations Table -->
                            <div class="mb-5">
                                <h5 class="fw-bold text-dark mb-3">26. Provide details of minimum 3 installations completed in the last 3 years including:</h5>
                                <div class="table-responsive border rounded-4 overflow-hidden shadow-sm">
                                    <table class="table table-bordered mb-0 align-middle">
                                        <thead style="background-color: #f1f3f4;">
                                            <tr class="text-center text-dark">
                                                <th style="width: 5%;">SN</th>
                                                <th style="width: 20%;">Client Name</th>
                                                <th style="width: 10%;">Year</th>
                                                <th style="width: 17%;">Type of APCD</th>
                                                <th style="width: 16%;">Capacity/Size</th>
                                                <th style="width: 15%;">Performance Result<br/><small>(if any)</small></th>
                                                <th style="width: 17%;">Upload Certificate</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var instList = ViewBag.Installations as List<APCD.Web.Models.InstallationRecord> ?? new List<APCD.Web.Models.InstallationRecord>();
                                                int maxRows = Math.Max(5, instList.Count);
                                            }
                                            @for (int j = 0; j < maxRows; j++)
                                            {
                                                var inst = j < instList.Count ? instList[j] : null;
                                                <tr>
                                                    <td class="text-center fw-bold bg-light">
                                                        @(j + 1)
                                                    </td>
                                                    <td><input type="text" name="installations[@j].ClientName" class="form-control form-control-sm border-0" value="@inst?.ClientName" @(j < 5 && ViewBag.IsSubmitted != true ? "required" : "") @(ViewBag.IsSubmitted == true ? "disabled" : "") /></td>
                                                    <td><input type="number" name="installations[@j].Year" class="form-control form-control-sm border-0 text-center" value="@inst?.Year" @(j < 5 && ViewBag.IsSubmitted != true ? "required" : "") @(ViewBag.IsSubmitted == true ? "disabled" : "") /></td>
                                                    <td><input type="text" name="installations[@j].ApcdType" class="form-control form-control-sm border-0" value="@inst?.ApcdType" @(j < 5 && ViewBag.IsSubmitted != true ? "required" : "") @(ViewBag.IsSubmitted == true ? "disabled" : "") /></td>
                                                    <td><input type="text" name="installations[@j].Capacity" class="form-control form-control-sm border-0" value="@inst?.Capacity" @(j < 5 && ViewBag.IsSubmitted != true ? "required" : "") @(ViewBag.IsSubmitted == true ? "disabled" : "") /></td>
                                                    <td><input type="text" name="installations[@j].PerformanceResult" class="form-control form-control-sm border-0" value="@inst?.PerformanceResult" @(ViewBag.IsSubmitted == true ? "disabled" : "") /></td>
                                                    <td id="card_PerformanceCertFile_@j">
                                                        <input type="hidden" name="installations[@j].PerformanceCertPath" value="@inst?.PerformanceCertPath" />
                                                        
                                                        <div class="upload-zone @(!string.IsNullOrEmpty(inst?.PerformanceCertPath) ? "d-none" : "")">
                                                            <input type="file" name="PerformanceCertFile_@j" class="form-control form-control-sm border-0" accept=".pdf" 
                                                                   onchange="uploadFileAjax(this, '@appId', 'Installation_@j', 'PerformanceCertificate', 'PerformanceCertFile_@j', 4)"
                                                                   @(j < 5 && string.IsNullOrEmpty(inst?.PerformanceCertPath) && ViewBag.IsSubmitted != true ? "required" : "") @(ViewBag.IsSubmitted == true ? "disabled" : "") />
                                                        </div>

                                                        <div class="status-zone @(!string.IsNullOrEmpty(inst?.PerformanceCertPath) ? "" : "d-none")">
                                                            <div class="d-flex flex-column gap-1">
                                                                <a href="@(inst?.PerformanceCertPath ?? "#")" target="_blank" class="extra-small text-success d-inline-block text-decoration-none fw-bold status-view-link">
                                                                    <i class="bi bi-file-earmark-check me-1"></i><span class="status-filename">View Uploaded</span>
                                                                </a>
                                                                @if (ViewBag.IsSubmitted != true) {
                                                                    <button type="button" class="btn btn-xs btn-link text-danger p-0 extra-small text-decoration-none text-start" 
                                                                            onclick="deleteFileAjax('@appId', 'Installation_@j', 'PerformanceCertificate', 'PerformanceCertFile_@j')">
                                                                        <i class="bi bi-trash me-1"></i>Remove
                                                                    </button>
                                                                }
                                                            </div>
                                                        </div>

                                                        <div class="loading-zone d-none text-center">
                                                            <div class="spinner-border spinner-border-sm text-primary" role="status" style="width: 1rem; height: 1rem;"></div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Section E & F Summary -->
                            <div class="row g-4 mt-5">
                                <div class="col-md-12">
                                    <h5 class="fw-bold mb-1 text-primary"><i class="bi bi-file-earmark-pdf me-2"></i> Section E & F: Technical Documents & Experience</h5>
                                    <p class="text-muted small">Upload mandatory technical documents for each technology applied for empanelment.</p>
                                </div>
                                
                                @{ 
                                    var docs = ViewBag.Documents as List<APCD.Web.Models.ApplicationDocument>;
                                    var supDocs = ViewBag.SupplementalDocuments as List<APCD.Web.Models.SupplementalDocument>;
                                }

                                <!-- Technical Catalogues (Global) -->
                                <div class="col-md-6">
                                    <div id="card_techCatalogueFile" class="p-3 border rounded-3 bg-light h-100 shadow-sm border-primary-subtle">
                                        <label class="form-group-label fw-bold text-dark mb-2">27. Technical Catalogues / Brochures <span class="text-danger">*</span></label>
                                        
                                        @{
                                            var catalogueDoc = docs?.FirstOrDefault(d => d.DocumentType == "TechnicalCatalogue");
                                        }

                                        <div class="upload-zone @(catalogueDoc != null ? "d-none" : "")">
                                            <input type="file" name="techCatalogueFile" class="form-control form-control-sm" accept=".pdf" 
                                                   onchange="uploadFileAjax(this, '@appId', '', 'TechnicalCatalogue', 'techCatalogueFile', 4)"
                                                   @(ViewBag.IsSubmitted == true ? "disabled" : "") />
                                        </div>

                                        <div class="status-zone @(catalogueDoc != null ? "" : "d-none")">
                                            <div class="d-flex flex-column gap-2">
                                                <div class="d-flex align-items-center gap-2 text-success small fw-bold">
                                                    <i class="bi bi-file-earmark-check-fill fs-5"></i>
                                                    <span class="text-truncate status-filename">Uploaded: @(catalogueDoc?.FileName)</span>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <a href="@(catalogueDoc?.FilePath ?? "#")" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                    @if (ViewBag.IsSubmitted != true) {
                                                        <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('@appId', '', 'TechnicalCatalogue', 'techCatalogueFile')">Remove</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="loading-zone d-none text-center py-2">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                            <span class="small ms-2">Uploading...</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Dynamic Document Containers -->
                            <div id="tech-docs-container" class="mt-4 animate-fade-in">
                                <!-- JS will inject technical document sections here -->
                            </div>
                        </fieldset>

                        <!-- Navigation -->
                        <div class="mt-5 pt-4 border-top d-flex justify-content-between">
                            <a asp-action="Step3" asp-route-id="@appId" class="btn btn-wizard-prev shadow-sm">
                                <i class="bi bi-arrow-left me-2"></i> Previous
                            </a>
                            @if (ViewBag.IsAddMoreMode == true)
                            {
                                <button type="submit" class="btn btn-wizard-next shadow-sm">
                                    Save & Continue <i class="bi bi-arrow-right ms-2"></i>
                                </button>
                            }
                            else if (ViewBag.IsSubmitted == true)
                            {
                                <a asp-action="Step5" asp-route-id="@appId" class="btn btn-wizard-next shadow-sm">
                                    Next Step: Financials <i class="bi bi-arrow-right ms-2"></i>
                                </a>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-wizard-next shadow-sm">
                                    Next Step: Financials <i class="bi bi-arrow-right ms-2"></i>
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_DocumentUploadScripts" />
    <script>
        const isSubmitted = @(ViewBag.IsSubmitted == true ? "true" : "false");
        const isAddMoreMode = @(ViewBag.IsAddMoreMode == true ? "true" : "false");
        const existingDocs = @Html.Raw(Json.Serialize(ViewBag.JsonDocuments));
        const existingSupDocs = @Html.Raw(Json.Serialize(ViewBag.SupplementalDocuments != null ? ((List<APCD.Web.Models.SupplementalDocument>)ViewBag.SupplementalDocuments).Select(d => new { documentType = d.DocumentType, apcdType = d.APCDType, fileName = d.FileName, filePath = d.FilePath }) : new List<object>()));
        const appId = '@appId';

        function onUploadSuccess(docType, tech, fileName, filePath) {
            const existingIdx = existingDocs.findIndex(d => d.documentType === docType && d.associatedTech === tech);
            if (existingIdx > -1) {
                existingDocs[existingIdx] = { documentType: docType, associatedTech: tech, fileName: fileName, filePath: filePath };
            } else {
                existingDocs.push({ documentType: docType, associatedTech: tech, fileName: fileName, filePath: filePath });
            }
        }

        function onDeleteSuccess(docType, tech) {
            const existingIdx = existingDocs.findIndex(d => d.documentType === docType && d.associatedTech === tech);
            if (existingIdx > -1) existingDocs.splice(existingIdx, 1);
        }

        const docTypes = [
            { id: 'productDatasheetFile', label: '28. Product Datasheets', type: 'ProductDatasheet' },
            { id: 'gaDrawingFile', label: '29. General Arrangement (GA) Drawing', type: 'GADrawing' },
            { id: 'processFlowFile', label: '30. Process Flow Diagram', type: 'ProcessFlowDiagram' },
            { id: 'designCalcFile', label: '31. Design Calculations', type: 'DesignCalculation' },
            { id: 'materialConstructionFile', label: '32. Material of Construction Certificates', type: 'MaterialOfConstruction' },
            { id: 'warrantyFile', label: '33. Warranty Documents', type: 'WarrantyDocument' },
            { id: 'installationExpFile', label: '34. Experience in Installation (Annexure-6a/6b)', type: 'InstallationExperience' },
            { id: 'clientPerformanceFile', label: '35. Client Performance Certificate', type: 'ClientPerformanceCertificate' },
            { id: 'testCertificateFile', label: '36. Test Certificates (Internal/NABL)', type: 'TestCertificate' }
        ];

        function updateTechDocuments() {
            const container = document.getElementById('tech-docs-container');
            const selectedTechs = [];
            
            // New ones
            document.querySelectorAll('.tech-apply-checkbox:checked').forEach(cb => {
                selectedTechs.push({ name: cb.dataset.techName, locked: false });
            });
            
            // Locked ones
            document.querySelectorAll('input[type="hidden"][name$=".IsAppliedForEmpanelment"][value="true"]').forEach(el => {
                const techName = el.dataset.techName;
                if (techName && !selectedTechs.find(t => t.name === techName)) {
                    selectedTechs.push({ name: techName, locked: true });
                }
            });

            container.innerHTML = '';

            selectedTechs.forEach(techObj => {
                const tech = techObj.name;
                const isLocked = (isSubmitted && (!isAddMoreMode || techObj.locked));
                const section = document.createElement('div');
                section.className = 'tech-doc-section mb-5 p-4 border-start border-4 border-primary rounded-end-4 bg-light shadow-sm animate-fade-in';
                const safeTechId = tech.replace(/\s+/g, '_').replace(/[\(\)\/]/g, '_');
                
                section.innerHTML = `
                    <div class="d-flex align-items-center mb-4 border-bottom pb-2">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px;">
                            <i class="bi bi-gear-fill small"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-0">Documents for: <span class="text-primary">${tech}</span> ${isLocked && !isSubmitted ? '<span class="badge bg-success ms-2">Already Approved</span>' : ''}</h6>
                    </div>
                    <div class="row g-3">
                        ${docTypes.map(doc => {
                            const foundDoc = existingDocs.find(d => d.documentType === doc.type && d.associatedTech === tech) || 
                                             existingSupDocs.find(d => d.documentType === doc.type && d.apcdType === tech);
                            const fileInputKey = `${doc.id}_${safeTechId}`;
                            
                            return `
                            <div class="col-md-6 col-lg-4">
                                <div id="card_${fileInputKey}" class="p-3 border rounded-3 h-100 bg-white shadow-sm hover-elevate transition-all ${isLocked ? 'opacity-75' : ''}">
                                    <label class="form-label small fw-bold text-secondary mb-2">${doc.label} <span class="text-danger">*</span></label>
                                    
                                    <div class="upload-zone ${foundDoc ? 'd-none' : ''}">
                                        <input type="file" name="${fileInputKey}" class="form-control form-control-sm" accept=".pdf" 
                                               onchange="uploadFileAjax(this, '@appId', '${tech}', '${doc.type}', '${fileInputKey}', 4)"
                                               ${isLocked ? 'disabled' : ''} />
                                    </div>

                                    <div class="status-zone ${foundDoc ? '' : 'd-none'}">
                                        <div class="d-flex flex-column gap-2">
                                            <div class="d-flex align-items-center gap-2 text-success small fw-bold">
                                                <i class="bi bi-file-earmark-check-fill fs-5"></i>
                                                <span class="text-truncate status-filename" style="max-width: 150px;">Uploaded: ${foundDoc ? foundDoc.fileName : ''}</span>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <a href="${foundDoc ? foundDoc.filePath : '#'}" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                ${!isLocked ? `<button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('${appId}', '${tech}', '${doc.type}', '${fileInputKey}')">Remove</button>` : ''}
                                            </div>
                                        </div>
                                    </div>

                                    <div class="loading-zone d-none text-center py-2">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                        <span class="small ms-2">Uploading...</span>
                                    </div>
                                </div>
                            </div>`;
                        }).join('')}
                    </div>
                `;
                container.appendChild(section);
            });
        }

        document.querySelectorAll('.tech-apply-checkbox').forEach(cb => {
            cb.addEventListener('change', updateTechDocuments);
        });

        function syncRowInputs(row) {
            if (isSubmitted) return;

            const isMfg = row.querySelector('.tech-mfg-checkbox')?.checked || false;
            const isApply = row.querySelector('.tech-apply-checkbox')?.checked || false;
            const isActive = isMfg || isApply;

            const categorySelect = row.querySelector('.tech-category-select');
            const capacityInput = row.querySelector('.tech-capacity-input');
            const typeInput = row.querySelector('.tech-type-input');

            if (!isActive) {
                if (categorySelect) categorySelect.value = ""; // NA
                if (capacityInput) capacityInput.value = "";
                if (typeInput) typeInput.value = "";
            }
        }

        document.querySelectorAll('.data-grid-row').forEach(row => {
            const mfgCb = row.querySelector('.tech-mfg-checkbox');
            const applyCb = row.querySelector('.tech-apply-checkbox');
            
            if (mfgCb) {
                mfgCb.addEventListener('change', () => syncRowInputs(row));
            }
            if (applyCb) {
                applyCb.addEventListener('change', () => syncRowInputs(row));
            }
            
            // Initialize on load for each row
            if (mfgCb || applyCb) {
                syncRowInputs(row);
            }
        });

        // Initialize documents on load
        document.addEventListener('DOMContentLoaded', updateTechDocuments);
    </script>
}
