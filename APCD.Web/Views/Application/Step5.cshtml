@model APCD.Web.Models.EmpanelmentApplication
@{
    ViewData["Title"] = "Financials & History";
    int currentStep = 5;
    var turnoverYears = ViewBag.FinancialYears as List<string> ?? new List<string> { "2023-24", "2024-25", "2025-26" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/application-form.css" asp-append-version="true" />
}

<div class="container py-4">
    <div class="card wizard-container border-0 shadow-lg">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-lg-3">
                <partial name="_WizardSidebar" model="currentStep" />
            </div>

            <!-- Main Content -->
            <div class="col-lg-9 bg-white">
                <div class="wizard-main">
                    @if (ViewBag.IsSubmitted == true)
                    {
                        <div class="alert alert-info d-flex align-items-center border-0 shadow-sm mb-4 py-3" style="background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%); border-left: 5px solid #0ea5e9 !important;">
                            <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">View Mode – Submission Completed</h6>
                                <p class="small mb-0 text-muted">This application has been submitted and is currently in read-only mode. No further edits are allowed.</p>
                            </div>
                            <i class="bi bi-lock-fill ms-auto fs-3 text-info opacity-25"></i>
                        </div>
                    }

                    <form asp-action="SaveFinancials" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                        <fieldset @(ViewBag.IsSubmitted == true ? "disabled" : "")>
                            <div class="form-section-title">Step 5: Financials, Audits & History</div>
                            <p class="text-muted small mb-4">Provide certified financial data and client testimonials (Points 37, 38, 39, 40).</p>

                            <div class="row g-5">
                                <!-- Turnover (Point 17) -->
                                <div class="col-md-12">
                                    <h6 class="fw-bold mb-3"><i class="bi bi-currency-dollar me-2 text-primary"></i> 37. Year wise Turnover (Last 3 years)</h6>
                                    <p class="extra-small text-muted mb-3">Attach audited certificates in the Documents section later.</p>
                                    <div class="table-responsive rounded-3 bg-light border">
                                        <table class="table table-bordered mb-0">
                                            <thead class="bg-gov-blue text-white">
                                                <tr>
                                                    <th class="small py-2">Financial Year</th>
                                                    <th class="small py-2 text-center">Amount (₹ in Lakhs)</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var year in turnoverYears)
                                                {
                                                    var turnover = Model.Turnovers.FirstOrDefault(t => t.FinancialYear == year);
                                                    <tr>
                                                        <td class="fw-bold bg-white small">@year</td>
                                                        <td class="bg-white">
                                                            <input type="number" step="0.01" name="TurnoverAmount_@year" class="form-control form-control-sm border-0 text-center" placeholder="0.00" value="@turnover?.Amount" />
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="mt-3 p-3 bg-light border rounded-3 text-center">
                                        <div id="card_consolidatedTurnoverFile" class="mx-auto" style="max-width: 500px;">
                                            <label class="form-group-label fw-bold mb-2">Upload Consolidated Turnover Certificate (covers last 3 years)</label>
                                            @{ var turnoverDoc = Model.Documents?.FirstOrDefault(d => d.DocumentType == "ConsolidatedTurnover"); }
                                            
                                            <div class="upload-zone @(turnoverDoc != null ? "d-none" : "")">
                                                <input type="file" name="consolidatedTurnoverFile" class="form-control form-control-sm mb-2" accept=".pdf" 
                                                       onchange="uploadFileAjax(this, '@Model.Id', '', 'ConsolidatedTurnover', 'consolidatedTurnoverFile', 5)" />
                                            </div>

                                            <div class="status-zone @(turnoverDoc != null ? "" : "d-none")">
                                                <div class="d-flex align-items-center justify-content-center gap-3">
                                                    <div class="d-flex align-items-center gap-2 text-success small fw-bold">
                                                        <i class="bi bi-file-earmark-check-fill fs-5"></i>
                                                        <span class="status-filename">Uploaded: @(turnoverDoc?.FileName)</span>
                                                    </div>
                                                    <div class="d-flex gap-2">
                                                        <a href="@(turnoverDoc?.FilePath ?? "#")" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                        @if (ViewBag.IsSubmitted != true) {
                                                            <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('@Model.Id', '', 'ConsolidatedTurnover', 'consolidatedTurnoverFile')">Remove</button>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="loading-zone d-none text-center py-2">
                                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Bank Solvency (Point 18) -->
                                <div class="col-md-6">
                                    <h6 class="fw-bold mb-3"><i class="bi bi-bank me-2 text-primary"></i> 38. Bank Solvency Certificate</h6>
                                    <div id="card_bankSolvencyFile" class="p-3 bg-light border rounded-3 h-100 shadow-sm">
                                        <p class="small mb-2">Issued within last 12 months?</p>
                                        @{ var solvencyDoc = Model.Documents?.FirstOrDefault(d => d.DocumentType == "BankSolvency"); }
                                        
                                        <div class="upload-zone @(solvencyDoc != null ? "d-none" : "")">
                                            <input type="file" name="bankSolvencyFile" class="form-control form-control-sm mb-2" accept=".pdf" 
                                                   onchange="uploadFileAjax(this, '@Model.Id', '', 'BankSolvency', 'bankSolvencyFile', 5)" />
                                        </div>

                                        <div class="status-zone @(solvencyDoc != null ? "" : "d-none")">
                                            <div class="d-flex flex-column gap-2">
                                                <div class="d-flex align-items-center gap-2 text-success small fw-bold">
                                                    <i class="bi bi-file-earmark-check-fill fs-5"></i>
                                                    <span class="text-truncate status-filename" style="max-width: 200px;">Uploaded: @(solvencyDoc?.FileName)</span>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <a href="@(solvencyDoc?.FilePath ?? "#")" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                    @if (ViewBag.IsSubmitted != true) {
                                                        <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('@Model.Id', '', 'BankSolvency', 'bankSolvencyFile')">Remove</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="loading-zone d-none text-center py-2">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Grievance (Point 23) -->
                                <div class="col-md-6">
                                    <h6 class="fw-bold mb-3"><i class="bi bi-people me-2 text-primary"></i> 39. Grievance Redressal System</h6>
                                    <div class="p-3 bg-light border rounded-3 h-100 shadow-sm">
                                        <div class="form-check form-switch mt-2">
                                            <input asp-for="HasGrievanceSystem" class="form-check-input" type="checkbox" id="grievanceSwitch">
                                            <label class="form-check-label fw-semibold" for="grievanceSwitch">Does firm have a documented system?</label>
                                        </div>
                                        <span class="help-text d-block mt-2 small text-muted">If yes, details will be verified during visit.</span>
                                    </div>
                                </div>

                                <!-- Testimonials (Point 24) -->
                                <div class="col-md-12">
                                    <h6 class="fw-bold mb-3"><i class="bi bi-chat-right-quote me-2 text-primary"></i> 40. Client Testimonials (Annexure-12)</h6>
                                    <p class="small text-muted mb-3">Minimum 3 testimonials are required, preferably 1 from NCR region.</p>
                                    <div class="row g-3">
                                        @for(int k = 1; k <= 3; k++)
                                        {
                                            var docType = $"ClientTestimonial_{k}";
                                            var testimonialDoc = Model.Documents?.FirstOrDefault(d => d.DocumentType == docType);
                                            <div class="col-md-4">
                                                <div id="card_testimonialFile_@k" class="p-3 border rounded-3 bg-white text-center h-100 d-flex flex-column justify-content-between shadow-sm">
                                                    <div>
                                                        <div class="mb-2"><i class="bi bi-file-earmark-pdf fs-3 text-muted"></i></div>
                                                        <span class="small fw-bold d-block mb-2">Performance Cert @k</span>
                                                        
                                                        <div class="upload-zone @(testimonialDoc != null ? "d-none" : "")">
                                                            <input type="file" name="testimonialFile_@k" class="form-control form-control-sm mb-3" accept=".pdf" 
                                                                   onchange="uploadFileAjax(this, '@Model.Id', '', '@docType', 'testimonialFile_@k', 5)" />
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="status-zone @(testimonialDoc != null ? "" : "d-none")">
                                                        <div class="d-flex flex-column gap-2 align-items-center">
                                                            <span class="text-success small fw-bold"><i class="bi bi-check-circle-fill"></i> Uploaded</span>
                                                            <span class="d-block extra-small text-muted text-truncate status-filename" style="max-width: 150px;">@(testimonialDoc?.FileName)</span>
                                                            <div class="d-flex gap-2">
                                                                <a href="@(testimonialDoc?.FilePath ?? "#")" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                                @if (ViewBag.IsSubmitted != true) {
                                                                    <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('@Model.Id', '', '@docType', 'testimonialFile_@k')">Remove</button>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="loading-zone d-none text-center py-2">
                                                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                    </div>

                                                    @if (testimonialDoc == null && ViewBag.IsSubmitted != true) {
                                                        <div class="required-badge"><span class="text-danger extra-small"><i class="bi bi-x-circle"></i> Required</span></div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <!-- Additional Compliance Docs -->
                                <div class="col-md-12 mt-4 border-top pt-4">
                                    <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-file-earmark-check me-2"></i> Section H & I: Undertakings, Compliance & Operations</h5>
                                    <div class="row g-4">
                                        @{
                                            var complianceDocs = new[] {
                                                new { id = "bankAccountFile", label = "41. Bank Account Details (Annexure-10)", type = "BankAccountDetails" },
                                                new { id = "serviceSupportFile", label = "42. Service Support Undertaking (Annexure-4)", type = "ServiceSupportUndertaking" },
                                                new { id = "nonBlacklistingFile", label = "43. Non-Blacklisting Undertaking (Annexure-5)", type = "NonBlacklistingUndertaking" },
                                                new { id = "testCertificateFile", label = "44. Test Certificates of APCDs", type = "TestCertificate" },
                                                new { id = "gstFilingFile", label = "45. GST Filing Proof (Last 1 year)", type = "GSTFiling" },
                                                new { id = "noLegalDisputesFile", label = "46. No Legal Disputes Declaration (Annexure-8)", type = "NoLegalDisputes" },
                                                new { id = "complaintPolicyFile", label = "47. Complaint Handling Policy", type = "ComplaintPolicy" },
                                                new { id = "escalationMechFile", label = "48. Escalation Mechanism", type = "EscalationMechanism" },
                                                new { id = "unitPhotographsFile", label = "49. Photographs of Unit (Geo-tagged)", type = "UnitPhotographs" }
                                            };
                                        }

                                        @foreach (var doc in complianceDocs)
                                        {
                                            var foundDoc = Model.Documents?.FirstOrDefault(d => d.DocumentType == doc.type);
                                            <div class="col-md-4">
                                                <div id="card_@doc.id" class="p-3 border rounded-3 bg-light h-100 shadow-sm transition-all hover-elevate">
                                                    <label class="form-group-label fw-bold small mb-2">@doc.label</label>
                                                    
                                                    <div class="upload-zone @(foundDoc != null ? "d-none" : "")">
                                                        <input type="file" name="@doc.id" class="form-control form-control-sm" accept=".pdf" 
                                                               onchange="uploadFileAjax(this, '@Model.Id', '', '@doc.type', '@doc.id', 5)" />
                                                    </div>

                                                    <div class="status-zone @(foundDoc != null ? "" : "d-none")">
                                                        <div class="d-flex flex-column gap-2">
                                                            <div class="d-flex align-items-center gap-2 text-success small fw-bold">
                                                                <i class="bi bi-file-earmark-check-fill fs-5"></i>
                                                                <span class="text-truncate status-filename" style="max-width: 180px;">Uploaded: @(foundDoc?.FileName)</span>
                                                            </div>
                                                            <div class="d-flex gap-2">
                                                                <a href="@(foundDoc?.FilePath ?? "#")" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                                @if (ViewBag.IsSubmitted != true) {
                                                                    <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('@Model.Id', '', '@doc.type', '@doc.id')">Remove</button>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="loading-zone d-none text-center py-2">
                                                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </fieldset>

                        <!-- Navigation -->
                        <div class="mt-5 pt-4 border-top d-flex justify-content-between">
                            <a asp-action="Step4" asp-route-id="@Model.Id" class="btn btn-wizard-prev">
                                <i class="bi bi-arrow-left me-2"></i> Previous
                            </a>
                            @if (ViewBag.IsSubmitted == true)
                            {
                                <a asp-action="Review" asp-route-id="@Model.Id" class="btn btn-wizard-next">
                                    Next Step: Final Review <i class="bi bi-arrow-right ms-2"></i>
                                </a>
                            }
                            else
                            {
                                <button type="submit" name="hasGrievance" value="true" class="btn btn-wizard-next">
                                    Next Step: Final Review <i class="bi bi-arrow-right ms-2"></i>
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_DocumentUploadScripts" />
    <script>
        const existingDocs = @Html.Raw(Json.Serialize(ViewBag.JsonDocuments));
        
        function onUploadSuccess(docType, tech, fileName, filePath) {
            const existingIdx = existingDocs.findIndex(d => d.documentType === docType && d.associatedTech === tech);
            if (existingIdx > -1) {
                existingDocs[existingIdx] = { documentType: docType, associatedTech: tech, fileName: fileName, filePath: filePath };
            } else {
                existingDocs.push({ documentType: docType, associatedTech: tech, fileName: fileName, filePath: filePath });
            }
        }

        function onDeleteSuccess(docType, tech) {
            const existingIdx = existingDocs.findIndex(d => d.documentType === docType && d.associatedTech === tech);
            if (existingIdx > -1) existingDocs.splice(existingIdx, 1);
        }
    </script>
}
