@model APCD.Web.Models.PaymentViewModel
@using Microsoft.EntityFrameworkCore
@{
    ViewData["Title"] = "Fee Payment";
    int currentStep = 7;
    bool isAmendment = Model.Application?.Status != "Draft";
    string bgClass = isAmendment ? "bg-light text-muted" : "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/application-form.css" asp-append-version="true" />
    <style>
        .custom-input {
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            transition: all 0.2s;
            background-color: #f8fafc;
        }
        .custom-input:focus {
            border-color: #f59e0b;
            box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.1);
            background-color: #fff;
            outline: none;
        }
        .btn-xs {
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
        }
        .letter-spacing-1 {
            letter-spacing: 0.05em;
        }
        .animate-fade-in {
            animation: fadeIn 0.4s ease-out;
        }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .form-section-title {
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 1.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #f1f5f9;
        }
        .wizard-main {
            padding: 2.5rem;
        }
    </style>
}

<div class="container py-4">
    <div class="card wizard-container border-0 shadow-lg">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-lg-3">
                <partial name="_WizardSidebar" model="currentStep" />
            </div>

            <!-- Main Content -->
            <div class="col-lg-9 bg-white">
                <div class="wizard-main">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4 animate-fade-in" role="alert" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-left: 5px solid #22c55e !important;">
                            <i class="bi bi-check-circle-fill me-3 fs-5 text-success"></i>
                            <span class="fw-medium text-dark">@TempData["SuccessMessage"]</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (ViewBag.IsSubmitted == true && ViewBag.IsSupplemental != true)                 {
                        <div class="alert alert-info d-flex align-items-center border-0 shadow-sm mb-4 py-3" style="background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%); border-left: 5px solid #0ea5e9 !important;">
                            <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">View Mode – Submission Completed</h6>
                                <p class="small mb-0 text-muted">This application has been submitted and is currently in read-only mode. No further edits are allowed.</p>
                            </div>
                            <i class="bi bi-lock-fill ms-auto fs-3 text-info opacity-25"></i>
                        </div>
                    }

                    <form asp-action="Payment" method="post" asp-route-id="@Model.ApplicationId" asp-route-supplementalId="@ViewBag.SupplementalId" enctype="multipart/form-data">
                        <input type="hidden" name="supplementalId" value="@ViewBag.SupplementalId" />
                        <input type="hidden" asp-for="Amount" />
                        <input type="hidden" asp-for="APCDTypesCount" />
                        
                        <fieldset @(ViewBag.IsSubmitted == true && ViewBag.IsSupplemental != true ? "disabled" : "")>
                            <div class="form-section-title">25. Online payment details</div>
                            <p class="text-muted small mb-4">Provide details for both Application and Empanelment fee transactions.</p>

                            <!-- APPLICATION FEES -->
                            <div class="table-responsive mb-4 rounded border overflow-hidden">
                                <table class="table table-bordered align-middle mb-0">
                                    <thead style="background-color: #c9daf8;">
                                        <tr>
                                            <th colspan="2" class="fw-bold py-2 text-dark border-0 d-flex justify-content-between align-items-center">
                                                <span>Application Fees (₹25,000 plus applicable GST @@ 18%, non-refundable) *</span>
                                                @if (isAmendment) { <span class="badge bg-secondary extra-small">PREVIOUS PAYMENT HISTORY</span> }
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if(ViewBag.AppFeeDiscount > 0)
                                        {
                                            <tr>
                                                <td colspan="2" class="text-success small bg-success bg-opacity-10 py-1">
                                                    <i class="bi bi-info-circle-fill me-1"></i> Eligible for ₹@ViewBag.AppFeeDiscount.ToString("N2") GoI Policy Discount (15%) - <strong>Will be reimbursed later.</strong> Full amount required upfront.
                                                </td>
                                            </tr>
                                        }
                                        <tr>
                                            <td style="width: 40%;">Amount required (in ₹)</td>
                                            <td class="fw-bold text-primary">₹@ViewBag.AppFeeTotal.ToString("N2")</td>
                                        </tr>
                                        <tr>
                                            <td>Amount Deposited</td>
                                            <td class="p-0"><input asp-for="AppFeeAmountDeposited" class="form-control border-0 rounded-0 shadow-none px-2 @bgClass" readonly="@(isAmendment || ViewBag.IsSubmitted == true)" disabled="@(isAmendment || ViewBag.IsSubmitted == true)" required /></td>
                                        </tr>
                                        <tr>
                                            <td>Name of the remitter Bank</td>
                                            <td class="p-0"><input asp-for="AppFeeRemitterBank" class="form-control border-0 rounded-0 shadow-none px-2 @bgClass" readonly="@(isAmendment || ViewBag.IsSubmitted == true)" disabled="@(isAmendment || ViewBag.IsSubmitted == true)" required /></td>
                                        </tr>
                                        <tr>
                                            <td>UTR / NEFT no</td>
                                            <td class="p-0"><input asp-for="AppFeeUTRNumber" class="form-control border-0 rounded-0 shadow-none px-2 text-uppercase @bgClass" readonly="@(isAmendment || ViewBag.IsSubmitted == true)" disabled="@(isAmendment || ViewBag.IsSubmitted == true)" required /></td>
                                        </tr>
                                        <tr>
                                            <td>Date of payment</td>
                                            <td class="p-0"><input asp-for="AppFeePaymentDate" type="date" class="form-control border-0 rounded-0 shadow-none px-2 @bgClass" readonly="@(isAmendment || ViewBag.IsSubmitted == true)" disabled="@(isAmendment || ViewBag.IsSubmitted == true)" required /></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- EMPANELMENT FEES -->
                            <div class="table-responsive mb-4 rounded border overflow-hidden">
                                <table class="table table-bordered align-middle mb-0">
                                    <thead style="background-color: #c9daf8;">
                                        <tr>
                                            <th colspan="2" class="fw-bold py-2 text-dark border-0 d-flex justify-content-between align-items-center">
                                                <span>Empanelment Fees (₹65,000 plus applicable GST @@ 18% per unit, non-refundable) *</span>
                                                @if (isAmendment) { <span class="badge bg-secondary extra-small">PREVIOUS PAYMENT HISTORY</span> }
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if(ViewBag.EmpFeeDiscount > 0)
                                        {
                                            <tr>
                                                <td colspan="2" class="text-success small bg-success bg-opacity-10 py-1">
                                                    <i class="bi bi-info-circle-fill me-1"></i> Eligible for ₹@ViewBag.EmpFeeDiscount.ToString("N2") GoI Policy Discount (15%) - <strong>Will be reimbursed later.</strong> Full amount required upfront.
                                                </td>
                                            </tr>
                                        }
                                        <tr>
                                            <td style="width: 40%;">Number of APCD types applied for empanelment.</td>
                                            <td class="fw-bold fs-5 px-2">@(isAmendment ? Model.APCDTypesCount : ViewBag.APCDCount)</td>
                                        </tr>
                                        <tr>
                                            <td>Amount required (in ₹)</td>
                                            <td class="fw-bold text-primary px-2">₹@(isAmendment ? (Model.EmpFeeAmountDeposited > 0 ? Model.EmpFeeAmountDeposited.ToString("N2") : (Model.APCDTypesCount * 65000 * 1.18m).ToString("N2")) : ViewBag.EmpFeeTotal.ToString("N2"))</td>
                                        </tr>
                                        <tr>
                                            <td>Amount Deposited</td>
                                            <td class="p-0"><input asp-for="EmpFeeAmountDeposited" class="form-control border-0 rounded-0 shadow-none px-2 @bgClass" readonly="@(isAmendment || ViewBag.IsSubmitted == true)" disabled="@(isAmendment || ViewBag.IsSubmitted == true)" required /></td>
                                        </tr>
                                        <tr>
                                            <td>Name of the remitter Bank</td>
                                            <td class="p-0"><input asp-for="EmpFeeRemitterBank" class="form-control border-0 rounded-0 shadow-none px-2 @bgClass" readonly="@(isAmendment || ViewBag.IsSubmitted == true)" disabled="@(isAmendment || ViewBag.IsSubmitted == true)" required /></td>
                                        </tr>
                                        <tr>
                                            <td>UTR / NEFT no</td>
                                            <td class="p-0"><input asp-for="EmpFeeUTRNumber" class="form-control border-0 rounded-0 shadow-none px-2 text-uppercase @bgClass" readonly="@(isAmendment || ViewBag.IsSubmitted == true)" disabled="@(isAmendment || ViewBag.IsSubmitted == true)" required /></td>
                                        </tr>
                                        <tr>
                                            <td>Date of payment</td>
                                            <td class="p-0"><input asp-for="EmpFeePaymentDate" type="date" class="form-control border-0 rounded-0 shadow-none px-2 @bgClass" readonly="@(isAmendment || ViewBag.IsSubmitted == true)" disabled="@(isAmendment || ViewBag.IsSubmitted == true)" required /></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- PAYMENT HISTORY (For Amendments) -->
                            @if (isAmendment && Model.Application.Payments != null && Model.Application.Payments.Any())
                            {
                                <div class="mb-5">
                                    <h6 class="fw-bold text-muted text-uppercase extra-small letter-spacing mb-3">Transaction History</h6>
                                    <div class="table-responsive rounded-4 border overflow-hidden shadow-sm">
                                        <table class="table table-sm table-hover mb-0 align-middle">
                                            <thead class="bg-light">
                                                <tr class="extra-small text-muted">
                                                    <th class="ps-3 py-2">Type</th>
                                                    <th>UTR Number</th>
                                                    <th>Amount</th>
                                                    <th>Date</th>
                                                    <th class="text-end pe-3">Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var p in Model.Application.Payments.OrderBy(x => x.PaymentDate))
                                                {
                                                    <tr class="small">
                                                        <td class="ps-3 fw-bold">@p.Type</td>
                                                        <td class="text-uppercase">@p.UTRNumber</td>
                                                        <td>₹@(p.Amount?.ToString("N2") ?? "0.00")</td>
                                                        <td>@(p.PaymentDate?.ToShortDateString() ?? "N/A")</td>
                                                        <td class="text-end pe-3"><span class="badge bg-secondary extra-small">@p.Status</span></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }

                            <!-- SUPPLEMENTAL PAYMENT SECTION -->
                            @if (ViewBag.IsSupplemental == true)
                            {
                                <div class="form-section-title text-warning mt-5"><i class="bi bi-plus-circle-fill me-2"></i> Add More APCD: Supplemental Fee Payment</div>
                                
                                @if (ViewBag.SupplementalPaymentSaved == true)
                                {
                                    <div id="card_supplementalReceiptSaved" class="p-4 border rounded-3 bg-light mb-4 text-center border-top border-4 border-warning">
                                        <h5 class="fw-bold text-dark mb-2"><i class="bi bi-receipt me-2 text-warning"></i> Supplemental Payment Proof</h5>
                                        <p class="small text-muted mb-3">Receipt uploaded during Add More APCD supplemental payment.</p>
                                        
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                            <span class="small fw-bold text-success">Uploaded: @(System.IO.Path.GetFileName(Model.SupplementalReceiptPath ?? "Receipt.pdf"))</span>
                                            <div class="ms-3 d-flex gap-2">
                                                <a href="@(Model.SupplementalReceiptPath ?? "#")" target="_blank" class="btn btn-sm btn-outline-primary">View</a>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="alert alert-success border-0 shadow-sm rounded-4 py-3 mb-4 d-flex align-items-center" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-left: 5px solid #22c55e !important;">
                                        <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                                        <div>
                                            <h6 class="fw-bold mb-0 text-dark">Payment Details Recorded</h6>
                                            <p class="small mb-0 text-muted">The payment for newly added APCDs has been saved. Please review and proceed to finalize the supplemental submission.</p>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted small mb-4">Please pay the empanelment fee for the newly added APCD devices to complete the supplemental request.</p>

                                    <div class="row g-4 mb-4">
                                        <div class="col-md-7">
                                            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                                                <div class="card-header bg-warning bg-opacity-10 py-3 border-0">
                                                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-list-check me-2 text-warning"></i> Newly Added APCD Details</h6>
                                                </div>
                                                <div class="card-body p-4">
                                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                                        <div>
                                                            <div class="extra-small text-muted fw-bold text-uppercase mb-1">Total Newly Added</div>
                                                            <div class="fs-3 fw-bold text-dark">@ViewBag.NewApcdCount Units</div>
                                                        </div>
                                                        <div class="text-end">
                                                            <div class="extra-small text-muted fw-bold text-uppercase mb-1">Total Payable</div>
                                                            <div class="fs-3 fw-bold text-primary">₹@ViewBag.BalanceDue.ToString("N0")</div>
                                                        </div>
                                                    </div>

                                                    <div class="mb-0">
                                                        <div class="extra-small text-muted fw-bold text-uppercase mb-2">Device Types</div>
                                                        <div class="d-flex flex-wrap gap-2">
                                                            @foreach (var type in (ViewBag.NewApcdTypes as string ?? "").Split(", "))
                                                            {
                                                                <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 px-3 py-2 rounded-pill fw-medium">@type</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-5">
                                            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                                                <div class="card-header bg-dark bg-opacity-10 py-3 border-0">
                                                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-calculator me-2"></i> Fee Breakdown</h6>
                                                </div>
                                                <div class="card-body p-4">
                                                    <div class="d-flex justify-content-between mb-2">
                                                        <span class="text-muted small">Empanelment Fee (@ViewBag.NewApcdCount × ₹65,000)</span>
                                                        <span class="fw-bold small text-dark">₹@ViewBag.ExtraBase.ToString("N0")</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between mb-3">
                                                        <span class="text-muted small">GST (18%)</span>
                                                        <span class="fw-bold small text-dark">₹@ViewBag.ExtraGST.ToString("N0")</span>
                                                    </div>
                                                    <hr class="my-2">
                                                    <div class="d-flex justify-content-between">
                                                        <span class="fw-bold text-dark">Total Amount</span>
                                                        <span class="fw-bold text-primary fs-5">₹@ViewBag.BalanceDue.ToString("N0")</span>
                                                    </div>
                                                    <div class="mt-3 extra-small text-danger italic">
                                                        <i class="bi bi-info-circle me-1"></i> Registration fee not applicable for supplemental requests.
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden border-top border-4 border-warning">
                                        <div class="card-header bg-white py-3 border-bottom">
                                            <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-bank me-2 text-warning"></i> Current Supplemental Payment Form</h6>
                                        </div>
                                        <div class="card-body p-4">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label extra-small fw-bold text-muted text-uppercase">Amount Deposited (₹) <span class="text-danger">*</span></label>
                                                    <input asp-for="SupplementalAmountDeposited" class="form-control custom-input" placeholder="Enter actual deposited amount" required />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label extra-small fw-bold text-muted text-uppercase">Name of Remitter Bank <span class="text-danger">*</span></label>
                                                    <input asp-for="SupplementalBankName" class="form-control custom-input" placeholder="e.g. HDFC Bank, SBI" required />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label extra-small fw-bold text-muted text-uppercase">UTR / NEFT Number <span class="text-danger">*</span></label>
                                                    <input asp-for="SupplementalUTR" class="form-control custom-input text-uppercase fw-bold" placeholder="Transaction Reference No" required />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label extra-small fw-bold text-muted text-uppercase">Date of Payment <span class="text-danger">*</span></label>
                                                    <input asp-for="SupplementalPayDate" type="date" class="form-control custom-input" required />
                                                </div>
                                                <div class="col-md-12 mt-4">
                                                    <div id="card_supplementalReceiptFile" class="p-4 border border-2 border-dashed rounded-4 bg-light text-center border-warning">
                                                        <h6 class="fw-bold text-dark mb-2"><i class="bi bi-cloud-arrow-up me-2 text-warning"></i> Upload Payment Proof <span class="text-danger">*</span></h6>
                                                        <p class="extra-small text-muted mb-3">Upload PDF receipt from bank</p>
                                                        
                                                        <div class="upload-zone @(!string.IsNullOrEmpty(Model.SupplementalReceiptPath) ? "d-none" : "")">
                                                            <input type="file" name="supplementalReceiptFile" class="form-control w-75 mx-auto mb-2" accept=".pdf" 
                                                                   onchange="uploadFileAjax(this, '@Model.ApplicationId', 'Supplemental_@ViewBag.SupplementalId', 'SupplementalPaymentReceipt', 'supplementalReceiptFile', 7)" 
                                                                   @(string.IsNullOrEmpty(Model.SupplementalReceiptPath) ? "required" : "") />
                                                        </div>

                                                        <div class="status-zone @(!string.IsNullOrEmpty(Model.SupplementalReceiptPath) ? "" : "d-none")">
                                                            <div class="d-flex align-items-center justify-content-center gap-2">
                                                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                                                <span class="status-filename small fw-bold text-success">Uploaded Successfully</span>
                                                                <div class="ms-3 d-flex gap-2">
                                                                    <a href="@(Model.SupplementalReceiptPath ?? "#")" target="_blank" class="btn btn-sm btn-outline-primary status-view-link">View Receipt</a>
                                                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteFileAjax('@Model.ApplicationId', 'Supplemental_@ViewBag.SupplementalId', 'SupplementalPaymentReceipt', 'supplementalReceiptFile')">Remove</button>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="loading-zone d-none text-center py-2">
                                                            <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
                                                            <span class="ms-2 small text-muted">Uploading...</span>
                                                        </div>

                                                        <div class="extra-small text-muted italic mt-2">Only PDF files up to 5MB.</div>
                                                    </div>
                                                </div>
                                                <div class="col-md-12 text-center mt-4">
                                                    <button type="submit" asp-action="SaveSupplementalPayment" asp-route-id="@Model.ApplicationId" asp-route-supplementalId="@ViewBag.SupplementalId" class="btn btn-warning px-5 py-2 fw-bold rounded-pill shadow-sm">
                                                        <i class="bi bi-save me-2"></i> Save Payment Details
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }

                            <div class="alert alert-info py-3 px-4 rounded-3 border-0 mt-2 small mb-4 shadow-sm">
                                <h6 class="fw-bold mb-2"><i class="bi bi-info-square-fill me-2"></i> Bank Details for Payment</h6>
                                <p class="mb-1"><strong>Account Name:</strong> National Productivity Council</p>
                                <p class="mb-1"><strong>Bank Name:</strong> Axis Bank Ltd, Lodhi Road, New Delhi</p>
                                <p class="mb-1"><strong>Account Number:</strong> 911010041400000 | <strong>IFSC Code:</strong> UTIB0000007</p>
                            </div>

                            <!-- Payment Proof (Base) -->
                            <div id="card_paymentReceiptFile" class="p-4 border rounded-3 bg-light mb-4 text-center @(Model.Application?.Status == "Draft" ? "" : "opacity-75")">
                                <h5 class="fw-bold text-dark mb-2"><i class="bi bi-receipt me-2 text-primary"></i> 3. Proof of Initial Online Payment</h5>
                                <p class="small text-muted mb-3">Receipt uploaded during initial submission.</p>
                                
                                @{
                                    var paymentDoc = Model.Application?.Documents?.FirstOrDefault(d => d.DocumentType == "PaymentReceipt");
                                }
                                
                                <div class="d-flex flex-column align-items-center">
                                    <div class="upload-zone @(paymentDoc != null ? "d-none" : "")">
                                        <input type="file" name="paymentReceiptFile" class="form-control w-50 mx-auto mb-2" accept=".pdf" 
                                               onchange="uploadFileAjax(this, '@Model.ApplicationId', '', 'PaymentReceipt', 'paymentReceiptFile', 7)" 
                                               @(paymentDoc == null && ViewBag.IsSubmitted != true ? "required" : "") @(ViewBag.IsSubmitted == true ? "disabled" : "") />
                                    </div>

                                    <div class="status-zone @(paymentDoc != null ? "" : "d-none")">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                            <span class="status-filename small fw-bold text-success">Uploaded: @(paymentDoc?.FileName)</span>
                                            <div class="ms-3 d-flex gap-2">
                                                <a href="@paymentDoc?.FilePath" target="_blank" class="btn btn-sm btn-outline-primary status-view-link">View</a>
                                                @if (ViewBag.IsSubmitted != true)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteFileAjax('@Model.ApplicationId', '', 'PaymentReceipt', 'paymentReceiptFile')">Remove</button>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="loading-zone d-none text-center py-2">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                        <span class="ms-2 small text-muted">Uploading...</span>
                                    </div>
                                </div>
                            </div>
                        </fieldset>

                        <!-- Navigation -->
                        <div class="mt-5 pt-4 border-top d-flex justify-content-between">
                            <a asp-action="Review" asp-route-id="@Model.ApplicationId" class="btn btn-wizard-prev shadow-sm">
                                <i class="bi bi-arrow-left me-2"></i> @(Model.Application?.Status == "Draft" ? "Previous" : "Back to Review")
                            </a>
                            @if (ViewBag.IsSubmitted == true && ViewBag.IsSupplemental != true)
                            {
                                <a asp-action="Submit" asp-route-id="@Model.ApplicationId" class="btn btn-wizard-next shadow-sm">
                                    View Submission Summary <i class="bi bi-arrow-right ms-2"></i>
                                </a>
                            }
                            else if (Model.Application?.Status == "Draft" || (ViewBag.IsSupplemental == true))
                            {
                                <button type="submit" class="btn btn-wizard-next shadow-sm">
                                    @(Model.Application?.Status == "Draft" ? "Final Step: Finalize Submit" : "Final Step: Finalize Supplemental") <i class="bi bi-check2-all ms-2"></i>
                                </button>
                            }
                            else
                            {
                                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-success px-4 rounded-pill shadow-sm">
                                    <i class="bi bi-house-door me-1"></i> Return to Dashboard
                                </a>
                            }
                        </div>
                    </form>

                    <!-- Transaction History Section -->
                    <div class="mt-5 pt-5 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="fw-bold text-dark mb-0"><i class="bi bi-clock-history me-2 text-primary"></i> Payment Transaction History</h4>
                            <span class="badge bg-light text-muted border px-3 py-2 rounded-pill small fw-normal">Application Life-cycle Payments</span>
                        </div>

                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead class="bg-light">
                                        <tr class="extra-small text-muted text-uppercase fw-bold letter-spacing-1">
                                            <th class="ps-4 py-3">Type / Date</th>
                                            <th>APCD Details</th>
                                            <th>UTR / Reference</th>
                                            <th>Amount</th>
                                            <th>Status</th>
                                            <th class="text-end pe-4">Receipt</th>
                                        </tr>
                                    </thead>
                                    <tbody class="small">
                                        @if (Model.Application != null)
                                        {
                                            @* Initial Payments *@
                                            foreach (var p in Model.Application.Payments.OrderBy(p => p.CreatedAt))
                                            {
                                                <tr>
                                                    <td class="ps-4 py-4">
                                                        <div class="fw-bold text-dark">@(p.Type == APCD.Web.Models.PaymentType.AppFee ? "Registration Fee" : "Initial Empanelment Fee")</div>
                                                        <div class="extra-small text-muted">@p.PaymentDate?.ToString("dd MMM yyyy")</div>
                                                    </td>
                                                    <td>
                                                        <span class="text-muted">@(p.Type == APCD.Web.Models.PaymentType.AppFee ? "Processing Fee" : $"{p.APCDTypesCount} Devices")</span>
                                                    </td>
                                                    <td>
                                                        <span class="text-uppercase fw-medium text-dark">@p.UTRNumber</span>
                                                        <div class="extra-small text-muted">@p.RemitterBank</div>
                                                    </td>
                                                    <td>
                                                        <span class="fw-bold text-dark">₹@((p.Amount ?? 0).ToString("N0"))</span>
                                                    </td>
                                                    <td>
                                                        @{ var pColor = p.Status == "Approved" ? "success" : (p.Status == "Rejected" ? "danger" : "warning"); }
                                                        <span class="badge bg-@pColor bg-opacity-10 text-@pColor border border-@pColor border-opacity-25 px-2 py-1 rounded-pill">@p.Status</span>
                                                    </td>
                                                    <td class="text-end pe-4">
                                                        @if (!string.IsNullOrEmpty(p.ReceiptPath)) {
                                                            <a href="@p.ReceiptPath" target="_blank" class="btn btn-xs btn-outline-primary border-0 bg-light p-2 rounded-circle" title="View"><i class="bi bi-file-earmark-pdf fs-5"></i></a>
                                                        }
                                                    </td>
                                                </tr>
                                            }

                                            @* Supplemental Payments *@
                                            var db = (APCD.Web.Data.ApplicationDbContext)ViewContext.HttpContext.RequestServices.GetService(typeof(APCD.Web.Data.ApplicationDbContext));
                                            var supPayments = db.SupplementalPayments
                                                .Include(sp => sp.SupplementalRequest)
                                                .Where(sp => sp.SupplementalRequest.ApplicationId == Model.ApplicationId)
                                                .OrderBy(sp => sp.CreatedAt)
                                                .ToList();

                                            foreach (var sp in supPayments)
                                            {
                                                <tr>
                                                    <td class="ps-4 py-4">
                                                        <div class="fw-bold text-warning">Supplemental Fee</div>
                                                        <div class="extra-small text-muted">@sp.PaymentDate.ToString("dd MMM yyyy")</div>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex flex-column gap-1" style="max-width: 250px;">
                                                            <span class="fw-medium text-dark">@sp.NewlyAddedAPCDCount Units Added</span>
                                                            <span class="extra-small text-muted text-truncate" title="@sp.NewlyAddedAPCDTypes">@sp.NewlyAddedAPCDTypes</span>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="text-uppercase fw-medium text-dark">@sp.UTRNumber</span>
                                                        <div class="extra-small text-muted">@sp.BankName</div>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex flex-column">
                                                            <span class="fw-bold text-dark">₹@sp.AmountDeposited.ToString("N0")</span>
                                                            <span class="extra-small text-muted italic">Due: ₹@sp.TotalAmount.ToString("N0")</span>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @{ var spColor = sp.Status == "Approved" ? "success" : (sp.Status == "Rejected" ? "danger" : "warning"); }
                                                        <span class="badge bg-@spColor bg-opacity-10 text-@spColor border border-@spColor border-opacity-25 px-2 py-1 rounded-pill">@sp.Status</span>
                                                    </td>
                                                    <td class="text-end pe-4">
                                                        @if (!string.IsNullOrEmpty(sp.ReceiptPath)) {
                                                            <a href="@sp.ReceiptPath" target="_blank" class="btn btn-xs btn-outline-warning border-0 bg-light p-2 rounded-circle" title="View"><i class="bi bi-file-earmark-pdf fs-5 text-warning"></i></a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_DocumentUploadScripts" />
    <script>
        const existingDocs = @Html.Raw(Json.Serialize(ViewBag.JsonDocuments));
        
        function onUploadSuccess(docType, tech, fileName, filePath) {
            // Local state update if needed
        }

        function onDeleteSuccess(docType, tech) {
            // Local state update if needed
        }
    </script>
}
