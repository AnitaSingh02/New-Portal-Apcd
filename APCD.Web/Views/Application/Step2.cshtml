@model APCD.Web.Models.EmpanelmentApplication
@{
    ViewData["Title"] = "Classifications";
    int currentStep = 2;
}

@section Styles {
    <link rel="stylesheet" href="~/css/application-form.css" asp-append-version="true" />
}

<div class="container py-5">
    <div class="card wizard-container border-0 shadow-lg">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-lg-3">
                <partial name="_WizardSidebar" model="currentStep" />
            </div>

            <!-- Main Content -->
            <div class="col-lg-9 bg-white">
                <div class="wizard-main">
                    @if (ViewBag.IsSubmitted == true)
                    {
                        <div class="alert alert-info d-flex align-items-center border-0 shadow-sm mb-4 py-3" style="background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%); border-left: 5px solid #0ea5e9 !important;">
                            <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark">View Mode – Submission Completed</h6>
                                <p class="small mb-0 text-muted">This application has been submitted and is currently in read-only mode. No further edits are allowed.</p>
                            </div>
                            <i class="bi bi-lock-fill ms-auto fs-3 text-info opacity-25"></i>
                        </div>
                    }

                    <form asp-action="Step2" method="post" asp-route-id="@Model.Id" enctype="multipart/form-data">
                        <fieldset @(ViewBag.IsSubmitted == true ? "disabled" : "")>
                            <div class="form-section-title">Step 2: Classifications & Certifications</div>
                            <p class="text-muted small mb-4">Provide registration details and official certifications</p>

                            <div class="row g-4">
                                <!-- Registration Numbers & Certificates -->
                                <div class="col-md-12 mb-3">
                                    <h6 class="fw-bold mb-3"><i class="bi bi-building me-2 text-primary"></i> 14. Company Legal Certificates</h6>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div id="card_coRegFile" class="p-2 border rounded-3 bg-white h-100 shadow-sm">
                                                <label class="form-group-label small fw-bold">Company Registration Cert.</label>
                                                @{ var coRegDoc = Model.Documents?.FirstOrDefault(d => d.DocumentType == "CompanyRegistration"); }
                                                
                                                <div class="upload-zone @(coRegDoc != null ? "d-none" : "")">
                                                    <input type="file" name="coRegFile" class="form-control form-control-sm" accept=".pdf" 
                                                           onchange="uploadFileAjax(this, '@Model.Id', '', 'CoReg', 'coRegFile', 2)" />
                                                </div>

                                                <div class="status-zone @(coRegDoc != null ? "" : "d-none")">
                                                    <div class="d-flex flex-column gap-1">
                                                        <div class="d-flex align-items-center gap-2 text-success small fw-bold">
                                                            <i class="bi bi-file-earmark-check-fill fs-6"></i>
                                                            <span class="text-truncate status-filename">Uploaded: @(coRegDoc?.FileName)</span>
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            <a href="@(coRegDoc?.FilePath ?? "#")" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                            @if (ViewBag.IsSubmitted != true) {
                                                                <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('@Model.Id', '', 'CompanyRegistration', 'coRegFile')">Remove</button>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="loading-zone d-none text-center py-1">
                                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div id="card_gstinFile" class="p-2 border rounded-3 bg-white h-100 shadow-sm">
                                                <label class="form-group-label small fw-bold">15. GST Registration</label>
                                                <input type="text" class="form-control custom-input form-control-sm mb-1 opacity-75" value="@Model.User.CompanyProfile?.GSTNumber" readonly />
                                                @{ var gstinDoc = Model.Documents?.FirstOrDefault(d => d.DocumentType == "GSTINCertificate"); }
                                                
                                                <div class="upload-zone @(gstinDoc != null ? "d-none" : "")">
                                                    <input type="file" name="gstinFile" class="form-control form-control-sm" accept=".pdf" 
                                                           onchange="uploadFileAjax(this, '@Model.Id', '', 'GSTIN', 'gstFile', 2)" />
                                                </div>

                                                <div class="status-zone @(gstinDoc != null ? "" : "d-none")">
                                                    <div class="d-flex flex-column gap-1">
                                                        <div class="d-flex align-items-center gap-2 text-success small fw-bold">
                                                            <i class="bi bi-file-earmark-check-fill fs-6"></i>
                                                            <span class="text-truncate status-filename">Uploaded: @(gstinDoc?.FileName)</span>
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            <a href="@(gstinDoc?.FilePath ?? "#")" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                            @if (ViewBag.IsSubmitted != true) {
                                                                <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('@Model.Id', '', 'GSTINCertificate', 'gstinFile')">Remove</button>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="loading-zone d-none text-center py-1">
                                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div id="card_panFile" class="p-2 border rounded-3 bg-white h-100 shadow-sm">
                                                <label class="form-group-label small fw-bold">16. PAN Card</label>
                                                <input type="text" class="form-control custom-input form-control-sm mb-1 opacity-75" value="@Model.User.CompanyProfile?.PANNumber" readonly />
                                                @{ var panDoc = Model.Documents?.FirstOrDefault(d => d.DocumentType == "PANCard"); }
                                                
                                                <div class="upload-zone @(panDoc != null ? "d-none" : "")">
                                                    <input type="file" name="panFile" class="form-control form-control-sm" accept=".pdf" 
                                                           onchange="uploadFileAjax(this, '@Model.Id', '', 'PANCard', 'panFile', 2)" />
                                                </div>

                                                <div class="status-zone @(panDoc != null ? "" : "d-none")">
                                                    <div class="d-flex flex-column gap-1">
                                                        <div class="d-flex align-items-center gap-2 text-success small fw-bold">
                                                            <i class="bi bi-file-earmark-check-fill fs-6"></i>
                                                            <span class="text-truncate status-filename">Uploaded: @(panDoc?.FileName)</span>
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            <a href="@(panDoc?.FilePath ?? "#")" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                            @if (ViewBag.IsSubmitted != true) {
                                                                <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('@Model.Id', '', 'PANCard', 'panFile')">Remove</button>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="loading-zone d-none text-center py-1">
                                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- CTO (Point 9) -->
                                <div class="col-md-12 mt-3 mb-3">
                                    <div id="card_ctoFile" class="p-3 border rounded-3 bg-white shadow-sm">
                                        <h6 class="fw-bold mb-2 small"><i class="bi bi-file-earmark-check me-2 text-primary"></i> 17. Consent to Operate (CTO)</h6>
                                        <p class="extra-small text-muted mb-2">Attach Consent to Operate Certificate, Intimation letter to SPCB, or Undertaking for Non-Applicability (Annexure-9)</p>
                                        
                                        @{ var ctoDoc = Model.Documents?.FirstOrDefault(d => d.DocumentType == "CTOCertificate"); }
                                        
                                        <div class="upload-zone @(ctoDoc != null ? "d-none" : "")">
                                            <input type="file" name="ctoFile" class="form-control form-control-sm w-50" accept=".pdf" 
                                                   onchange="uploadFileAjax(this, '@Model.Id', '', 'CTOCertificate', 'ctoFile')" />
                                        </div>

                                        <div class="status-zone @(ctoDoc != null ? "" : "d-none")">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="d-flex align-items-center gap-2 text-success small fw-bold">
                                                    <i class="bi bi-file-earmark-check-fill fs-5"></i>
                                                    <span class="status-filename">Uploaded: @(ctoDoc?.FileName)</span>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <a href="@(ctoDoc?.FilePath ?? "#")" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                    @if (ViewBag.IsSubmitted != true) {
                                                        <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('@Model.Id', '', 'CTOCertificate', 'ctoFile')">Remove</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="loading-zone d-none text-center py-2">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Special Status -->
                                <div class="col-md-12 bg-light p-4 rounded-3 border">
                                    <h6 class="fw-bold mb-3"><i class="bi bi-tag-fill me-2 text-primary"></i> 18. Special Classifications (Eligible for 15% discount)</h6>
                                    <p class="extra-small text-muted mb-4">Select all applicable. Note: Benefits cannot be combined (Max 15%).</p>
                                    
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div id="card_mseFile" class="p-2 border rounded-3 bg-white h-100 shadow-sm">
                                                <div class="form-check form-switch mb-2">
                                                    <input asp-for="IsMSE" class="form-check-input" type="checkbox" id="mseSwitch">
                                                    <label class="form-check-label fw-semibold small" for="mseSwitch">MSE (Micro/Small Enterprise)</label>
                                                </div>
                                                <input asp-for="UdyamRegistrationNo" class="form-control custom-input form-control-sm mt-2" placeholder="Udyam Registration No." />
                                                
                                                @{ var mseDoc = Model.Documents?.FirstOrDefault(d => d.DocumentType == "MSECertificate"); }
                                                
                                                <div class="upload-zone @(mseDoc != null ? "d-none" : "") mt-2">
                                                    <input type="file" name="mseFile" class="form-control form-control-sm" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" 
                                                           onchange="uploadFileAjax(this, '@Model.Id', '', 'MSECertificate', 'mseFile')" />
                                                </div>

                                                <div class="status-zone @(mseDoc != null ? "" : "d-none") mt-2">
                                                    <div class="d-flex flex-column gap-1">
                                                        <div class="d-flex align-items-center gap-2 text-success small fw-bold">
                                                            <i class="bi bi-file-earmark-check-fill"></i>
                                                            <span class="text-truncate status-filename">Uploaded: @(mseDoc?.FileName)</span>
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            <a href="@(mseDoc?.FilePath ?? "#")" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                            @if (ViewBag.IsSubmitted != true) {
                                                                <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('@Model.Id', '', 'MSECertificate', 'mseFile')">Remove</button>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="loading-zone d-none text-center py-1">
                                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div id="card_startupFile" class="p-2 border rounded-3 bg-white h-100 shadow-sm">
                                                <div class="form-check form-switch mb-2">
                                                    <input asp-for="IsStartup" class="form-check-input" type="checkbox" id="startupSwitch">
                                                    <label class="form-check-label fw-semibold small" for="startupSwitch">Recognized Startup</label>
                                                </div>
                                                <input asp-for="DPIITRecognitionNo" class="form-control custom-input form-control-sm mt-2" placeholder="DPIIT Recognition No." />
                                                
                                                @{ var startupDoc = Model.Documents?.FirstOrDefault(d => d.DocumentType == "StartupCertificate"); }
                                                
                                                <div class="upload-zone @(startupDoc != null ? "d-none" : "") mt-2">
                                                    <input type="file" name="startupFile" class="form-control form-control-sm" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" 
                                                           onchange="uploadFileAjax(this, '@Model.Id', '', 'StartupCertificate', 'startupFile')" />
                                                </div>

                                                <div class="status-zone @(startupDoc != null ? "" : "d-none") mt-2">
                                                    <div class="d-flex flex-column gap-1">
                                                        <div class="d-flex align-items-center gap-2 text-success small fw-bold">
                                                            <i class="bi bi-file-earmark-check-fill"></i>
                                                            <span class="text-truncate status-filename">Uploaded: @(startupDoc?.FileName)</span>
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            <a href="@(startupDoc?.FilePath ?? "#")" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                            @if (ViewBag.IsSubmitted != true) {
                                                                <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('@Model.Id', '', 'StartupCertificate', 'startupFile')">Remove</button>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="loading-zone d-none text-center py-1">
                                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div id="card_localSupplierFile" class="p-2 border rounded-3 bg-white h-100 shadow-sm">
                                                <div class="form-check form-switch mb-2">
                                                    <input asp-for="IsLocalSupplier" class="form-check-input" type="checkbox" id="localSwitch">
                                                    <label class="form-check-label fw-semibold small" for="localSwitch">Class-I Local Supplier</label>
                                                </div>
                                                <span class="help-text small text-dark d-block">With ≥50% local content</span>
                                                
                                                @{ var localDoc = Model.Documents?.FirstOrDefault(d => d.DocumentType == "LocalSupplierCertificate"); }
                                                
                                                <div class="upload-zone @(localDoc != null ? "d-none" : "") mt-2">
                                                    <input type="file" name="localSupplierFile" class="form-control form-control-sm" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" 
                                                           onchange="uploadFileAjax(this, '@Model.Id', '', 'LocalSupplierCertificate', 'localSupplierFile')" />
                                                </div>

                                                <div class="status-zone @(localDoc != null ? "" : "d-none") mt-2">
                                                    <div class="d-flex flex-column gap-1">
                                                        <div class="d-flex align-items-center gap-2 text-success small fw-bold">
                                                            <i class="bi bi-file-earmark-check-fill"></i>
                                                            <span class="text-truncate status-filename">Uploaded: @(localDoc?.FileName)</span>
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            <a href="@(localDoc?.FilePath ?? "#")" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                            @if (ViewBag.IsSubmitted != true) {
                                                                <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('@Model.Id', '', 'LocalSupplierCertificate', 'localSupplierFile')">Remove</button>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="loading-zone d-none text-center py-1">
                                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div> 

                                <!-- Standards (Point 19) -->
                                <div class="col-md-12">
                                    <div id="card_isoStandardsFile" class="p-3 border rounded-3 bg-white shadow-sm">
                                        <label asp-for="ISOStandards" class="form-group-label fw-bold small">19. International Standards (ISO 9000/14000/etc.)</label>
                                        <textarea asp-for="ISOStandards" class="form-control custom-input mb-2" rows="2" placeholder="Please furnish details of standards qualified..."></textarea>
                                        
                                        @{ var isoDoc = Model.Documents?.FirstOrDefault(d => d.DocumentType == "ISOStandardsCertificate"); }
                                        
                                        <div class="upload-zone @(isoDoc != null ? "d-none" : "")">
                                            <input type="file" name="isoStandardsFile" class="form-control form-control-sm" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" 
                                                   onchange="uploadFileAjax(this, '@Model.Id', '', 'ISOStandardsCertificate', 'isoStandardsFile')" />
                                        </div>

                                        <div class="status-zone @(isoDoc != null ? "" : "d-none")">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="d-flex align-items-center gap-2 text-success small fw-bold">
                                                    <i class="bi bi-file-earmark-check-fill fs-5"></i>
                                                    <span class="status-filename">Uploaded: @(isoDoc?.FileName)</span>
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <a href="@(isoDoc?.FilePath ?? "#")" target="_blank" class="btn btn-xs btn-outline-primary py-0 px-2 small status-view-link">View</a>
                                                    @if (ViewBag.IsSubmitted != true) {
                                                        <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 small" onclick="deleteFileAjax('@Model.Id', '', 'ISOStandardsCertificate', 'isoStandardsFile')">Remove</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="loading-zone d-none text-center py-2">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Blacklisting (Point 20) -->
                                <div class="col-md-12 p-4 rounded-3 border bg-light-danger" style="background-color: #fff8f8;">
                                    <label class="form-group-label">20. Blacklisting Status</label>
                                    <div class="mb-3">
                                        <div class="form-check form-check-inline me-4">
                                            <input class="form-check-input" type="radio" value="false" asp-for="IsBlacklisted" id="notBlacklisted">
                                            <label class="form-check-label" for="notBlacklisted">No, Not Blacklisted</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" value="true" asp-for="IsBlacklisted" id="isBlacklisted">
                                            <label class="form-check-label text-danger fw-bold" for="isBlacklisted">Yes, Blacklisted</label>
                                        </div>
                                    </div>
                                    <textarea asp-for="BlacklistDetails" class="form-control custom-input" rows="2" placeholder="If yes, provide details of government institution (Central/State) or Agency."></textarea>
                                </div>
                            </div>
                        </fieldset>

                        <!-- Form Actions -->
                        <div class="mt-5 pt-4 border-top d-flex justify-content-between">
                            <a asp-action="Step1" asp-route-id="@Model.Id" class="btn btn-wizard-prev">
                                <i class="bi bi-arrow-left me-2"></i> Previous
                            </a>
                            @if (ViewBag.IsSubmitted == true)
                            {
                                <a asp-action="Step3" asp-route-id="@Model.Id" class="btn btn-wizard-next">
                                    Next Step: Key Personnel <i class="bi bi-arrow-right ms-2"></i>
                                </a>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-wizard-next">
                                    Next Step: Key Personnel <i class="bi bi-arrow-right ms-2"></i>
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_DocumentUploadScripts" />
    <script>
        const existingDocs = @Html.Raw(Json.Serialize(ViewBag.JsonDocuments));
        
        function onUploadSuccess(docType, tech, fileName, filePath) {
            const existingIdx = existingDocs.findIndex(d => d.documentType === docType && d.associatedTech === tech);
            if (existingIdx > -1) {
                existingDocs[existingIdx] = { documentType: docType, associatedTech: tech, fileName: fileName, filePath: filePath };
            } else {
                existingDocs.push({ documentType: docType, associatedTech: tech, fileName: fileName, filePath: filePath });
            }
        }

        function onDeleteSuccess(docType, tech) {
            const existingIdx = existingDocs.findIndex(d => d.documentType === docType && d.associatedTech === tech);
            if (existingIdx > -1) existingDocs.splice(existingIdx, 1);
        }
    </script>
}
