<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - APCD Portal | NPC</title>
    
    <!-- Core CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    
    <!-- Premium Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        :root {
            --gov-green: #1f5e3b;
            --gov-green-hover: #2d8554;
            --gov-text: #333333;
            --gov-border: #e5e5e5;
            --saas-bg: #ffffff;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--saas-bg);
            color: var(--gov-text);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Header Section */
        .gov-header {
            background: #ffffff;
            padding: 10px 0;
            border-bottom: 1px solid var(--gov-border);
        }
        
        .gov-header-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }
        
        .brand-section {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .brand-logos {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        
        .brand-logos img {
            height: 52px;
            object-fit: contain;
        }
        
        .brand-title {
            color: var(--gov-green);
            font-weight: 700;
            line-height: 1.2;
            padding-left: 0.75rem;
            border-left: 1px solid #ddd;
        }
        
        .brand-title h1 {
            font-size: 1.2rem;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 0.2px;
            color: var(--gov-green);
            font-weight: 800;
        }
        
        .brand-title p {
            font-size: 0.9rem;
            margin: 0;
            color: #555;
            font-weight: 600;
            text-transform: uppercase;
        }

        /* Navbar Section */
        .gov-navbar {
            background: var(--gov-green);
            padding: 0;
            min-height: 48px;
        }
        
        .gov-navbar .nav-link {
            color: #ffffff !important;
            font-weight: 500;
            padding: 12px 24px !important;
            transition: all 0.2s;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }
        
        .gov-navbar .nav-link:hover {
            background: var(--gov-green-hover);
        }

        /* Header Actions */
        .header-actions {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }
        
        .header-actions .btn-login {
            color: var(--gov-text);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: color 0.2s;
        }
        
        .header-actions .btn-login:hover {
            color: var(--gov-green);
        }
        
        .header-actions .btn-register {
            background: var(--gov-green);
            color: white !important;
            font-weight: 600;
            padding: 9px 24px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.2s;
            border: none;
        }
        
        .header-actions .btn-register:hover {
            background: var(--gov-green-hover);
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        /* Main Content */
        main {
            flex-grow: 1;
        }

        /* Footer overrides */
        .saas-footer {
            background-color: #1a1a1a;
        }
        
        @@media (max-width: 991px) {
            .gov-header-container { flex-direction: column; text-align: center; gap: 1rem; }
            .brand-section { flex-direction: column; }
            .brand-title { border-left: none; padding-left: 0; margin-top: 0.5rem; }
            .header-actions { margin-bottom: 0.5rem; }
            .gov-navbar .nav-link { padding: 10px 15px !important; text-align: center; }
        }

    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Government Style Header -->
    <header class="gov-header">
        <div class="gov-header-container">
            <!-- Left: Logos and Title -->
            <div class="brand-section">
                <div class="brand-logos">
                    <img src="~/images/npc-logo.png" alt="NPC Logo" />
                    <img src="~/images/apcd-logo.png" alt="APCD Logo" />
                </div>
                <div class="brand-title">
                    <h1>Air Pollution Control Device Empanelment Scheme</h1>
                </div>
            </div>

            <!-- Right: Actions -->
            <div class="header-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn-register" asp-controller="Dashboard" asp-action="Index">
                        Dashboard
                    </a>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                        <button type="submit" class="btn-login border-0 bg-transparent">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="btn-login" asp-controller="Auth" asp-action="Login">
                        Sign in
                    </a>
                    <a class="btn-register" asp-controller="Auth" asp-action="Register">
                        Create account
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Solid Green Navbar -->
    <nav class="navbar navbar-expand-lg gov-navbar sticky-top">
        <div class="container">
            <button class="navbar-toggler border-white text-white" type="button" data-bs-toggle="collapse" data-bs-target="#govNav">
                <i class="bi bi-list fs-3"></i>
            </button>
            <div class="collapse navbar-collapse" id="govNav">
                <ul class="navbar-nav w-100 justify-content-start">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#process">Process</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#fees">Fees</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#faq">FAQ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contact">Contact Us</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


    <main role="main">
        @RenderBody()
    </main>

    <!-- SaaS Footer -->
    <footer class="saas-footer">
        <div class="container">
            <div class="row g-5 mb-5">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <img src="~/images/apcd-logo.png" alt="APCD Logo" height="40" class="brightness-0 invert opacity-75">
                    </div>
                    <p class="small text-white mb-4 pe-lg-4" style="line-height: 1.6;">NPC is a national-level organization to promote productivity culture in India. Established by the Ministry of Industry, Government of India in 1958.</p>
                    <div>
                        <h6 class="text-white fw-semibold mb-3 fs-6">Stay Updated</h6>
                        <div class="input-group input-group-sm mb-3" style="max-width: 300px;">
                            <input type="email" class="form-control newsletter-input" placeholder="Email Address">
                            <button class="btn newsletter-btn px-3" type="button"><i class="bi bi-send-fill"></i></button>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-2 col-md-4">
                    <h5 class="text-white">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="footer-link small mb-3">About NPC</a></li>
                        <li><a href="#" class="footer-link small mb-3">CPCB Guidelines</a></li>
                        <li><a href="#" class="footer-link small mb-3">Empanelment</a></li>
                        <li><a href="#" class="footer-link small mb-3">Committee</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-2 col-md-4">
                    <h5 class="text-white">Support</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="footer-link small mb-3">Help Desk</a></li>
                        <li><a href="#" class="footer-link small mb-3">FAQs</a></li>
                        <li><a href="#" class="footer-link small mb-3">Privacy Policy</a></li>
                        <li><a href="#" class="footer-link small mb-3">Terms of Service</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-4 col-md-4">
                    <h5 class="text-white">Contact Us</h5>
                    <div class="d-flex mb-3 align-items-start">
                        <div class="bg-white bg-opacity-10 p-2 rounded-circle me-3 text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-geo-alt-fill" style="font-size: 0.85rem;"></i>
                        </div>
                        <span class="small text-white mt-1">Utpadakta Bhawan, 5-6 Institutional Area, Lodhi Road, New Delhi - 110003</span>
                    </div>
                    <div class="d-flex mb-3 align-items-start">
                        <div class="bg-white bg-opacity-10 p-2 rounded-circle me-3 text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-telephone-fill" style="font-size: 0.85rem;"></i>
                        </div>
                        <span class="small text-white mt-1">+91-11-24607325, 8368303555</span>
                    </div>
                    <div class="d-flex align-items-start">
                        <div class="bg-white bg-opacity-10 p-2 rounded-circle me-3 text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-envelope-fill" style="font-size: 0.85rem;"></i>
                        </div>
                        <span class="small text-white mt-1">eca.group@npcindia.gov.in</span>
                    </div>
                </div>
            </div>
            
            <div class="pt-4 border-top border-secondary border-opacity-25 d-flex flex-column flex-md-row justify-content-between align-items-center">
                <p class="small text-muted mb-2 mb-md-0">&copy; @DateTime.Now.Year National Productivity Council. All rights reserved.</p>
                <div class="d-flex align-items-center gap-3">
                    <a href="#" class="text-muted text-decoration-none"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" class="text-muted text-decoration-none"><i class="bi bi-linkedin"></i></a>
                    <a href="#" class="text-muted text-decoration-none"><i class="bi bi-youtube"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
