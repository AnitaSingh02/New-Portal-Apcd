@{
    ViewData["Title"] = "Set New Password";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - APCD Portal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            margin: 0;
            padding: 0;
        }

        .auth-container {
            min-height: 100vh;
            display: flex;
            background: #ffffff;
        }

        /* Left Side: Premium Brand Gradient */
        .auth-brand-side {
            flex: 1;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0d6efd 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
            padding: 3rem;
            color: white;
        }

        .glass-orb {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .orb-1 { width: 300px; height: 300px; top: -100px; left: -100px; }
        .orb-2 { width: 400px; height: 400px; bottom: -150px; right: -150px; }
        
        .brand-content {
            position: relative;
            z-index: 10;
            text-align: center;
            max-width: 500px;
        }

        .brand-logo-wrapper {
            background: rgba(255, 255, 255, 0.95);
            padding: 1.5rem;
            border-radius: 1.5rem;
            display: inline-block;
            margin-bottom: 2rem;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        }

        /* Right Side: Form */
        .auth-form-side {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2rem;
            background-color: #f8fafc;
        }

        .auth-form-wrapper {
            width: 100%;
            max-width: 440px;
            background: white;
            padding: 3rem;
            border-radius: 1.5rem;
            box-shadow: 0 10px 40px rgba(0,0,0,0.04);
            border: 1px solid rgba(0,0,0,0.05);
        }

        .auth-title {
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 0.5rem;
            font-size: 1.75rem;
        }

        .auth-subtitle {
            color: #64748b;
            font-size: 0.95rem;
            margin-bottom: 2.5rem;
        }

        /* Form Controls */
        .form-floating > .form-control {
            border: 1.5px solid #e2e8f0;
            border-radius: 0.75rem;
            padding: 1rem 1.25rem;
            height: calc(3.5rem + 2px);
            font-weight: 500;
            color: #334155;
            transition: all 0.2s ease;
        }
        
        .form-floating > .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.1);
        }

        .form-floating > label {
            padding: 1rem 1.25rem;
            color: #94a3b8;
            font-weight: 500;
        }
        
        .password-toggle {
            position: absolute;
            right: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            cursor: pointer;
            z-index: 10;
            transition: color 0.2s;
        }
        .password-toggle:hover { color: #0d6efd; }

        /* Buttons */
        .btn-auth-submit {
            background: linear-gradient(135deg, #0d6efd, #0043a8);
            color: white;
            border: none;
            border-radius: 0.75rem;
            padding: 1rem;
            font-weight: 600;
            font-size: 1rem;
            width: 100%;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(13, 110, 253, 0.3);
            margin-top: 1rem;
        }
        
        .btn-auth-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(13, 110, 253, 0.4);
            color: white;
        }

        /* Responsive */
        @@media (max-width: 992px) {
            .auth-brand-side { display: none; }
            .auth-form-side { padding: 1rem; }
            .auth-form-wrapper { box-shadow: none; border: none; background: transparent; padding: 2rem; }
            body { background-color: white; }
        }
    </style>
</head>
<body>

<div class="auth-container">
    
    <!-- Left Premium Brand Side -->
    <div class="auth-brand-side d-none d-lg-flex">
        <div class="glass-orb orb-1"></div>
        <div class="glass-orb orb-2"></div>
        
        <div class="brand-content">
            <div class="brand-logo-wrapper">
                <img src="~/images/apcd-logo.png" alt="APCD Logo" width="180">
            </div>
            <h1 class="fw-bolder mb-3" style="letter-spacing: -0.5px; font-size: 2.5rem;">APCD Empanelment Portal</h1>
            <p class="fs-5 text-white-50 mb-0">National Productivity Council for CPCB</p>
        </div>
    </div>

    <!-- Right Form Side -->
    <div class="auth-form-side">
        <div class="auth-form-wrapper">
            
            <div class="text-center mb-4">
                <div class="d-inline-flex justify-content-center align-items-center rounded-circle mb-3" style="width:70px; height:70px; background: rgba(25, 135, 84, 0.1); color: #198754;">
                    <i class="bi bi-shield-lock-fill fs-2"></i>
                </div>
                <h2 class="auth-title text-center">Create New Password</h2>
                <p class="auth-subtitle text-center">Please choose a strong, secure password for your account.</p>
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger bg-danger-subtle text-danger border-0 rounded-3 mb-4 d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-3 fs-5"></i>
                    <div style="font-size: 0.9rem; font-weight: 500;">@ViewBag.ErrorMessage</div>
                </div>
            }

            <form asp-action="ResetPassword" method="post">
                <!-- Secret Payload -->
                <input type="hidden" name="token" value="@ViewBag.Token" />
                <input type="hidden" name="email" value="@ViewBag.Email" />
                
                <div class="form-floating mb-4 position-relative">
                    <input type="password" name="newPassword" class="form-control" id="floatingNewPassword" placeholder="New Password" required>
                    <label for="floatingNewPassword">New Secure Password</label>
                    <i class="bi bi-eye password-toggle fs-5" onclick="togglePassword('floatingNewPassword')"></i>
                </div>
                
                <div class="form-floating mb-5 position-relative">
                    <input type="password" name="confirmPassword" class="form-control" id="floatingConfirmPassword" placeholder="Confirm Password" required>
                    <label for="floatingConfirmPassword">Confirm New Password</label>
                    <i class="bi bi-eye password-toggle fs-5" onclick="togglePassword('floatingConfirmPassword')"></i>
                </div>
                
                <button type="submit" class="btn-auth-submit mb-4">
                    Update Password & Secure Account <i class="bi bi-shield-check ms-2"></i>
                </button>

                <div class="text-center mt-4 pt-3 border-top border-light">
                    <a href="/" class="text-secondary text-decoration-none d-flex align-items-center justify-content-center" style="font-size: 0.9rem; font-weight: 500; transition: color 0.2s;">
                        <i class="bi bi-house-door me-2"></i> Back to Home
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function togglePassword(id) {
        const input = document.getElementById(id);
        const icon = event.target;
        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace("bi-eye", "bi-eye-slash");
            icon.classList.add("text-primary");
        } else {
            input.type = "password";
            icon.classList.replace("bi-eye-slash", "bi-eye");
            icon.classList.remove("text-primary");
        }
    }
</script>

</body>
</html>
